    bottom: 0px;
  }

  /* slickスライダーの矢印アイコンのサイズ調整 */
  .slick-prev::before,
  .slick-next::before {
    font-size: 18px;
    height: 25px;
    line-height: 20px;
    width: 25px;
  }

  /* slickスライダーの矢印位置調整 */
  .slick-prev {
    right: 30px;
  }

  /* ポストコンテンツ内のiframeの幅と高さ調整 */
