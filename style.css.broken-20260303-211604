    opacity 0.3s ease,
    -webkit-transform 0.3s ease;
  -o-transition:
    transform 0.3s ease,
    opacity 0.3s ease;
  transition:
    transform 0.3s ease,
    opacity 0.3s ease;
  transition:
    transform 0.3s ease,
