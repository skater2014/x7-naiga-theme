  color: var(--link-color-black);
}
body.dark-theme .post-date a {
  color: var(--link-color-blue);
}

/* 正しい post-author */
.post-author a {
  color: var(--link-color-black);
}
body.dark-theme .post-author a {
  color: var(--link-color-blue);
}

/* tagcloud はライト/ダークを明示 */
.tagcloud a {
  color: var(--link-color-black);
}
body.dark-theme .tagcloud a {
  color: var(--link-color-blue);
}

/* port-body はライト/ダークを明示 */
.port-body a {
  color: var(--link-color-black);
  text-decoration: none;
}
body.dark-theme .port-body a {
  color: var(--link-color-blue);
  text-decoration: none;
}

/* メインタイトル系を明示 */
#main h1 a,
#main h2 a,
.content-box a h2,
.content-box1 h2 a {
  color: var(--link-color-black);
}
body.dark-theme #main h1 a,
body.dark-theme #main h2 a,
body.dark-theme .content-box a h2,
body.dark-theme .content-box1 h2 a {
  color: var(--link-color-white);
}

/* navg の誤記崩れを明示上書き */
.navg__list > li > a {
  color: var(--link-color-white) !important;
}

