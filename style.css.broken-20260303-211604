/* ============== グリッド（共通） ============== */
.archive-posts {
  margin: 0 -8px;
}
.archive-posts::after {
  content: '';
  display: block;
  clear: both;
} /* floatのクリア */

.archive-post-box {
  float: left;
  width: calc(25% - 16px); /* 4列 */
  margin: 0 8px 16px;
  overflow: hidden;
}
.archive-post-box:nth-child(4n + 1) {
  clear: left;
} /* 1,5,9,... の先頭を改行 */

/* タブレット：3列 */
@media (max-width: 1024px) {
  .archive-post-box {
    width: calc(33.333% - 16px);
  }
  .archive-post-box:nth-child(3n + 1) {
    clear: left;
  }
}

/* スマホ：2列 */
@media (max-width: 767px) {
  .archive-post-box {
    width: calc(50% - 16px);
  }
  .archive-post-box:nth-child(2n + 1) {
    clear: left;
  }
}

/* 極小：1列 */
@media (max-width: 480px) {
  .archive-post-box {
    width: calc(100% - 16px);
  }
}

/* ============== サムネ枠（16:9・共通） ============== */
.archive-post-feature {
  position: relative;
  aspect-ratio: 16 / 9; /* 比率固定（JS不要） */
  width: 100%;
  height: auto;
  overflow: hidden;
}

