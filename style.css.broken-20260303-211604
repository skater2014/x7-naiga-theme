  justify-content: space-around; /* 要素間に均等なスペースを追加 */
  margin-bottom: 20px; /* 下部の余白を増やす */
}

.gender-selection label {
  display: -webkit-box;
  display: -ms-flexbox;
  display: flex; /* ラベル内の要素をFlexboxで配置 */
  -webkit-box-align: center;
  -ms-flex-align: center;
  align-items: center; /* 垂直方向に中央揃え */
