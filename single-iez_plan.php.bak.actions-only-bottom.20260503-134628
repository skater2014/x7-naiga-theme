<?php
/**
 * single-iez_plan.php
 *
 * 家づくりプラン詳細ページ
 */

if (!defined('ABSPATH')) {
    exit;
}

if (isset($_GET['plan_pdf']) && $_GET['plan_pdf'] === '1') {
    $pdf_template = get_template_directory() . '/hub/pages/iezukuri/templates/pdf-plan.php';

    if (file_exists($pdf_template)) {
        include $pdf_template;
        exit;
    }

    wp_die('PDF専用テンプレートが見つかりません。');
}

get_header('customhome');

$page_id = get_queried_object_id();
$slug    = $page_id ? get_post_field('post_name', $page_id) : '';

$upload_dir = wp_upload_dir();

$generated_pdf_path = '';
$generated_pdf_url  = '';

if ($slug !== '' && !empty($upload_dir['basedir'])) {
    $generated_pdf_path = trailingslashit($upload_dir['basedir']) . 'iezukuri-pdf/' . $slug . '.pdf';

    /*
     * wp_upload_dir()['baseurl'] が本番URLになっている環境があるため、
     * 表示URLは現在の home_url() から作る。
     */
    $generated_pdf_url = home_url('/wp-content/uploads/iezukuri-pdf/' . $slug . '.pdf');
}

$has_generated_pdf = (
    $generated_pdf_path &&
    file_exists($generated_pdf_path) &&
    filesize($generated_pdf_path) > 0
);
?>

<main
    id="primary"
    class="hub-customhome-subpage iezukuri-subpage iezukuri-plan-single iezukuri-plan-single--<?php echo esc_attr($slug); ?>
    <nav class="iez-plan-single-back-nav" aria-label="参考プラン一覧へ戻る">
        <a class="iez-plan-single-back-nav__link" href="<?php echo esc_url(home_url('/iezukuri/plans/')); ?>">
            ← 参考プラン一覧へ戻る
        </a>
    </nav>

"
    data-iezukuri-page="plan-single"
    data-iezukuri-slug="<?php echo esc_attr($slug); ?>"
>
<?php
    if (function_exists('naigai_iezukuri_render_block')) {
        naigai_iezukuri_render_block('plan-viewer');
    } else {
        $block = get_template_directory() . '/hub/pages/iezukuri/template-parts/subpage/blocks/block-plan-viewer.php';

        if (file_exists($block)) {
            include $block;
        }
    }
    ?>

    <nav class="iez-plan-single-actions-nav" aria-label="プラン詳細操作">
        <div class="iez-plan-single-control__actions">
                <a class="iez-plan-single-control__btn is-primary" href="<?php echo esc_url(home_url('/iezukuri/contact/')); ?>">
                    この間取りで相談する
                </a>
    
                <?php if ($has_generated_pdf) : ?>
                    <a class="iez-plan-single-control__btn" href="<?php echo esc_url($generated_pdf_url); ?>" download>
                        PDFダウンロード
                    </a>
                <?php endif; ?>
            </div>
    </nav>

</main>

<?php
get_footer();
