<?php
if (!defined(ABSPATH)) {
    exit;
}

/**
 * =========================================================
 * Hub assets
 * =========================================================
 *
 * 対象:
 * - front-page.php
 * - template-realestate-hub.php
 * - template-construction-hub.php
 *
 * 方針:
 * - Hub は hub/common/css/hub.css だけ読む
 * - JS は hub/common/js/hub-swiper-init.js だけ読む
 * - ページ差分は hub.css 内で
 *   .hub-page-front
 *   .hub-page-realestate
 *   .hub-page-construction
 *   などのクラスで分ける
 * - minpaku とは混ぜない
 */
function naigai_enqueue_hub_assets()
{
    if (!function_exists(naigai_is_hub_page) || !naigai_is_hub_page()) {
        return;
    }

    $theme_dir = get_template_directory();
    $theme_uri = get_template_directory_uri();

    $hub_css = /hub/common/css/hub.css;
    if (file_exists($theme_dir . $hub_css)) {
        wp_enqueue_style(
            naigai-hub,
            $theme_uri . $hub_css,
            array(),
            filemtime($theme_dir . $hub_css)
        );
    }

    $hub_swiper_js = /hub/common/js/hub-swiper-init.js;
    if (file_exists($theme_dir . $hub_swiper_js)) {
        wp_enqueue_script(
            naigai-hub-swiper-init,
            $theme_uri . $hub_swiper_js,
            array(jquery),
            filemtime($theme_dir . $hub_swiper_js),
            true
        );
    }
}
add_action(wp_enqueue_scripts, naigai_enqueue_hub_assets, 30);
