/** キャラ用テンプレを使っている固定ページか？ */
if (!function_exists('gw_is_genshin_build_template')) {
  function gw_is_genshin_build_template($post_id){
    // ★必要に応じて、あなたのテンプレファイル名を増減
    $preferred = [
      'template-genshin-character.php',
      'page-genshin-build.php',
      'genshin-character.php',
    ];
    $slug = get_page_template_slug($post_id);
    return $slug && in_array($slug, $preferred, true);
  }
}

/** 情報ソースの優先度（大きいほど強い） */
if (!function_exists('gw_card_rank')) {
  function gw_card_rank(array $card){
    $id = (int)($card['id'] ?? 0);
    if ($id && get_post_type($id) === 'page') {
      if (gw_is_genshin_build_template($id)) return 100; // テンプレ付き固定ページ
      return 90;                                          // 通常固定ページ
    }
    if ($id && get_post_type($id) === 'genshin_build') return 80; // CPT
    return 10;                                                    // レガシー
  }
}

/** 既存カードと新カードを優先度でマージ（弱い方は捨てる） */
if (!function_exists('gw_merge_card')) {
  function gw_merge_card(array $old, array $new){
    $r_old = gw_card_rank($old);
    $r_new = gw_card_rank($new);
    if ($r_new > $r_old) {
      // new が勝つ。空欄は old で補完
      foreach (['element','weapon','rarity','element_icon','icon','tier','alt'] as $k){
        if (($new[$k] ?? '') === '' && isset($old[$k])) $new[$k] = $old[$k];
      }
      return $new;
    }
    return $old; // 同格以下は現状維持
  }
}

/* ===============================
 * 投稿→カード配列 変換
 * =============================== */
if (!function_exists('gw_build_card_from_post')) {
  function gw_build_card_from_post($pid, $type='page', $override_link=null){
    $raw_name = trim((string) get_post_meta($pid, '_gwc_char_name', true));
