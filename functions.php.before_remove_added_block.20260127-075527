function gwc_save_custom_fields($post_id) {
    if (defined('DOING_AUTOSAVE') && DOING_AUTOSAVE) return;
    if (!current_user_can('edit_post', $post_id)) return;

    $fields = array_merge(gwc_get_fields(''), gwc_get_fields('New-'));

    foreach ($fields as $field) {
        // 通常フィールド
        if (isset($_POST[$field])) {
            $val = sanitize_text_field($_POST[$field]);
            $val === '' ? delete_post_meta($post_id, $field) : update_post_meta($post_id, $field, $val);
        }

        // ページリンク (別扱い)
        $link_key = $field.'_link';
        if (isset($_POST[$link_key])) {
            $id = (int) $_POST[$link_key];
            $id ? update_post_meta($post_id, $link_key, $id) : delete_post_meta($post_id, $link_key);
        }
    }
}
add_action('save_post', 'gwc_save_custom_fields');

