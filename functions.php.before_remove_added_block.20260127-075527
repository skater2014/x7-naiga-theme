// Ajaxアクションを定義
add_action('wp_ajax_get_post_titles', 'custom_ajax_get_post_titles');
add_action('wp_ajax_nopriv_get_post_titles', 'custom_ajax_get_post_titles');

function custom_ajax_get_post_titles() {
    if (!defined('DOING_AJAX') || !DOING_AJAX) {
        wp_die();
    }

    $args = array(
        "posts_per_page" => -1,
        'post_type'      => array( 'post', 'genshin_updated' ),
        'post_status'    => 'publish'
    );

    $the_query = new WP_Query($args);
    $cdContents = array();

    if ($the_query->have_posts()) {
        while ($the_query->have_posts()) {
            $the_query->the_post();
            $ID = get_the_ID();

            $excerpt = wp_trim_words(get_the_excerpt(), 20, '...');
            $content = wp_trim_words(get_the_content(), 20, '...');

            $title = htmlspecialchars_decode(get_the_title());
            $title = removeKeywordsFromTitle($title);

            $cdContents[] = array(
                "pamalink"      => get_permalink(),
                "title"         => $title,
                "start"         => get_the_date("Y-m-d"),
                "allDay"        => true,
                "eyecatch"      => get_the_post_thumbnail_url($ID, 'small'),
                "eyecatch_alt"  => get_post_meta($ID, '_wp_attachment_image_alt', true),
                "excerpt"       => $excerpt,
                "content"       => $content,
            );
        }
    }

    wp_reset_postdata();

    if (!headers_sent()) {
        header('Content-Type: application/json');
    }

    echo wp_json_encode($cdContents);
    wp_die();
}


// キーワードを削除する関数
function removeKeywordsFromTitle($title) {
    $keywords = array('Genshin Impact', 'Genshin-Impact', 'Tekken7');
    $trimmedTitle = $title;

    foreach ($keywords as $keyword) {
        $regex = '/\b' . preg_quote($keyword, '/') . '\b/i'; // キーワードを正規表現のパターンに変換
        $trimmedTitle = preg_replace($regex, '', $trimmedTitle); // タイトルからキーワードを削除
    }

    return trim($trimmedTitle);
}




