 * --------------------------------------------------------- */
function save_slider_items_metabox($post_id) {
  if (!isset($_POST['gw_slider_items_metabox_nonce']) ||
      !wp_verify_nonce($_POST['gw_slider_items_metabox_nonce'], 'gw_slider_items_metabox')) return;

  if (defined('DOING_AUTOSAVE') && DOING_AUTOSAVE) return;
  if (!current_user_can('edit_post', $post_id)) return;

  $items = [];
  $legacy_images = [];

  // ✅ まず “配列入力” を読む（これが一番確実）
  $types  = isset($_POST['gw_slider_item_type'])  ? (array)$_POST['gw_slider_item_type']  : [];
  $values = isset($_POST['gw_slider_item_value']) ? (array)$_POST['gw_slider_item_value'] : [];

  if (!empty($types) && count($types) === count($values)) {
    foreach ($types as $i => $t) {
      $t = sanitize_text_field($t);
      $v = wp_unslash($values[$i]);

      if ($t === 'youtube') {
        $id = gw_extract_youtube_id($v);
        if ($id) $items[] = ['type'=>'youtube','id'=>$id];
      } elseif ($t === 'image') {
        $url = esc_url_raw($v);
        if ($url) {
          $items[] = ['type'=>'image','url'=>$url];
          $legacy_images[] = $url;
        }
      }
    }

    update_post_meta($post_id, GW_SLIDER_META_ITEMS, $items);
    update_post_meta($post_id, GW_SLIDER_META_LEGACY_IMAGES, $legacy_images);
    return;
  }

  // ✅ 保険：配列が無い場合は JSON hidden を読む
  if (!isset($_POST['slider_items'])) return;

  $decoded = json_decode(wp_unslash($_POST['slider_items']), true);
  if (!is_array($decoded)) return;

  foreach ($decoded as $it) {
    $type = $it['type'] ?? '';
    if ($type === 'youtube') {
      $id = gw_extract_youtube_id($it['id'] ?? '');
      if ($id) $items[] = ['type'=>'youtube','id'=>$id];
    } elseif ($type === 'image') {
      $url = esc_url_raw($it['url'] ?? '');
      if ($url) {
        $items[] = ['type'=>'image','url'=>$url];
        $legacy_images[] = $url;
      }
    }
  }

  update_post_meta($post_id, GW_SLIDER_META_ITEMS, $items);
  update_post_meta($post_id, GW_SLIDER_META_LEGACY_IMAGES, $legacy_images);
}
add_action('save_post', 'save_slider_items_metabox', 10, 1);


