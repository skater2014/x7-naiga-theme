// ============================
// ✅ 抜粋を「読みやすく」作る（共通化）
// - ブロック境界に空白を入れて “AdsGenshin” を防ぐ
// - 余計な文言（Turn Off Ads / Contents 等）を削る
// - 短くする（既定80文字）
// ============================

if (!function_exists('gw_readable_excerpt_by_id')) {
  function gw_readable_excerpt_by_id($post_id, $max = 80) {
    $post_id = (int) $post_id;
    if ($post_id <= 0) return '';

    // get_the_excerpt() は再帰しやすいので生値から作る
    $raw = (string) get_post_field('post_excerpt', $post_id);
    if ($raw === '') {
      $raw = (string) get_post_field('post_content', $post_id);
    }

    $title_txt = trim((string) get_the_title($post_id));

    // ブロック境界に空白（AdsGenshinみたいな結合を防ぐ）
    $ex = preg_replace('~<\\s*br\\s*/?\\s*>~i', ' ', $raw);
    $ex = preg_replace('~</\\s*(p|div|li|h[1-6]|tr|td|th)\\s*>~i', ' ', $ex);

    // ショートコード→タグ除去→空白正規化
    $ex = strip_shortcodes($ex);
    $ex = wp_strip_all_tags($ex);
    $ex = trim(preg_replace('/\\s+/', ' ', $ex));

    // ゴミ除去（必要なら追加OK）
    $ex = preg_replace('/\\bTurn\\s*Off\\s*Ads\\b/i', '', $ex);
    $ex = preg_replace('/\\bContents\\b/i', '', $ex);
    $ex = trim(preg_replace('/\\s+/', ' ', $ex));

    // タイトルが先頭なら削る
    if ($title_txt !== '' && stripos($ex, $title_txt) === 0) {
      $ex = trim(mb_substr($ex, mb_strlen($title_txt, 'UTF-8'), null, 'UTF-8'));
    }

    $max = (int) $max;
    if ($max <= 0) $max = 80;
    return mb_strimwidth($ex, 0, $max, '…', 'UTF-8');
  }
}

// get_the_excerpt() を差し替える（Swiperカードの抜粋もこれで直る）
add_filter('get_the_excerpt', function($excerpt, $post) {
  if ($post instanceof WP_Post) {
    return gw_readable_excerpt_by_id($post->ID, 80);
  }
  return $excerpt;
}, 20, 2);

/**
 * ============================================================
 * GameWidth: 共通ページャ + 共通クエリ調整（functions.php）
 * ============================================================
 *
 * 目的：
 * 1) paginate_links() のURL生成を壊さない（base/format二重化や ?paged の崩れを防止）
 * 2) s / post_type / view をページャーで保持
 * 3) 「不要にページ番号が増える」系の事故を、found_posts から total 再計算して抑える
 * 4) （任意）メインクエリに対して posts_per_page 等を共通設定する
 *
 * 注意：
 * - pre_get_posts は「メインクエリ」だけに効く。
 *   つまり search.php 内で new WP_Query() を使っている場合、
 *   そのWP_Queryには pre_get_posts の変更は反映されない（=あなたのsearch.phpは自前で設定済みだからOK）。
 */


/* ------------------------------------------------------------
 * view パラメータの正規化
 * ------------------------------------------------------------ */

/**
 * view パラメータを 'grid' / 'list' に正規化する。
 * - それ以外は全部 'list' 扱い（変な値が来ても崩れない）
 */
if (!function_exists('gw_get_view_param')) {
  function gw_get_view_param() {
    $v = isset($_GET['view']) ? sanitize_text_field(wp_unslash($_GET['view'])) : '';
    return ($v === 'grid') ? 'grid' : 'list';
  }
}


/* ------------------------------------------------------------
 * ページャーで保持したい GET パラメータ
 * ------------------------------------------------------------ */

/**
 * いまのURLパラメータをページャーリンクに引き継ぐ。
 * - s / post_type / view を保持する
 */
if (!function_exists('gw_build_pager_add_args')) {
  function gw_build_pager_add_args($view_param = 'list') {
    $add_args = [];

    // 検索キーワード：空でも保持したいなら isset を見る（あなたの方式）
    if (isset($_GET['s'])) {
      $add_args['s'] = (string) wp_unslash($_GET['s']); // '' のままでもOK
    }

    // 絞り込み：post_type
    if (isset($_GET['post_type'])) {
      $add_args['post_type'] = sanitize_text_field(wp_unslash($_GET['post_type']));
    }

    // 表示モード：grid/list
    $add_args['view'] = ($view_param === 'grid') ? 'grid' : 'list';

    return $add_args;
  }
}


/* ------------------------------------------------------------
 * 共通ページャ本体
 * ------------------------------------------------------------ */

/**
 * ✅共通ページャ（カテゴリ専用WP_Query / メインクエリ どっちでもOK）
 *
 * 使い方：
 * - メインクエリ：gw_render_pager(null, gw_get_view_param());
 * - カスタムWP_Query：gw_render_pager($my_query, $view_param);
 *
 * 重要：
 * - total が壊れる（不要なページ番号が大量に出る）ときがあるので、
 *   found_posts / posts_per_page で total を再計算して抑える。
 */
if (!function_exists('gw_render_pager')) {
  function gw_render_pager($query = null, $view_param = 'list') {

    // 1) クエリ未指定ならメインクエリを使う
    if (!$query) {
      global $wp_query;
      $query = $wp_query;
    }

    // 2) 現在ページ（/page/2/ でも ?paged=2 でも get_query_var('paged') が正）
    $paged = max(1, (int) get_query_var('paged', 1));

    // 3) posts_per_page の決定（クエリ優先、無ければWP設定）
    $ppp = 0;
    if (is_object($query) && isset($query->query_vars['posts_per_page'])) {
      $ppp = (int) $query->query_vars['posts_per_page'];
    }
    if ($ppp <= 0) $ppp = (int) get_option('posts_per_page', 10);
    if ($ppp <= 0) $ppp = 10;

    // 4) ✅総ページ数（total）を安全に決める
    // - found_posts が取れるなら found_posts / ppp で再計算
    // - 取れない場合のみ max_num_pages を採用
    $total = 0;
    $found = 0;

    if (is_object($query) && isset($query->found_posts)) {
      $found = (int) $query->found_posts;
    }
    if ($found > 0) {
      $total = (int) ceil($found / $ppp);
    }
    if ($total <= 0 && is_object($query) && isset($query->max_num_pages)) {
      $total = (int) $query->max_num_pages;
    }

    $total = max(1, (int) $total);

    // 5) 1ページしか無いならページャ不要
    if ($total <= 1) return;

    // 6) base の作り方（壊れない）
    // - get_pagenum_link($big) は、prettyなら /page/999.../、plainなら ?paged=999... を返す
    // - そこから 999... を %#% に置換して base を作る
    $big = 999999999;

    $base_raw = get_pagenum_link($big, false);   // escapeしない（置換のため）
    $base     = str_replace($big, '%#%', $base_raw);

    // paged（%#%）は消さない。付け直すものだけ掃除して add_args に任せる。
    $base = remove_query_arg(['s', 'post_type', 'view'], $base);

    // 7) add_args（検索や表示モードを保持）
    $add_args = gw_build_pager_add_args($view_param);

    // 8) paginate_links
    $links = paginate_links([
      'base'      => $base,
      'format'    => '',          // ✅ base に %#% が入ってるので format は空（=二重化防止）
      'current'   => $paged,
      'total'     => $total,
      'prev_text' => '&#8592;',
      'next_text' => '&#8594;',
      'add_args'  => $add_args,
      'type'      => 'array',

      // 表示が多すぎる場合の抑制（必要なら調整）
      'mid_size'  => 2,
      'end_size'  => 1,
    ]);

    if (!$links) return;

    // 9) 出力（href内の &amp; を実URLに戻してから esc_url）
    echo '<div class="blog-pagination">';
    foreach ($links as $link) {
      $link = preg_replace_callback('/href=("|\')(.*?)\1/i', function ($m) {
        $href = html_entity_decode($m[2], ENT_QUOTES, 'UTF-8');
        return 'href="' . esc_url($href) . '"';
      }, $link);
      echo $link;
    }
    echo '</div>';
  }
}


