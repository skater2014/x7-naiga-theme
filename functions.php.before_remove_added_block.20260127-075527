      $type='youtube'; $video_id=$m[1];
    } elseif ( preg_match('/<lite-vimeo[^>]*videoid="([0-9]+)"/i', $content, $m) ) {
      $type='vimeo';   $video_id=$m[1];
    } elseif ( preg_match('~https?://(?:www\.)?youtu(?:\.be/|be\.com/(?:watch\?v=|shorts/))([A-Za-z0-9_\-]{6,})~', $content, $m) ) {
      $type='youtube'; $video_id=$m[1];
    } elseif ( preg_match('~https?://(?:www\.)?vimeo\.com/([0-9]+)~', $content, $m) ) {
      $type='vimeo';   $video_id=$m[1];
    }
    return array($type, $video_id);
  }
}

