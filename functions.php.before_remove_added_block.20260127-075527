/**
 * 添付ファイルページを完全に無効化（リダイレクト処理）
 *
 * 【目的】
 * WordPressは画像（例: royal_longsword.png）をアップロードすると、
 * 自動的に「添付ファイルページ（attachment page）」という個別のページ
 * （例: https://example.com/royal_longsword）を生成します。
 *
 * これらのページは、SEO的に重複・低品質とみなされる恐れがあり、
 * またユーザーにとっても画像しか表示されないため、不要なページです。
 *
 * この関数は、添付ファイルページへのアクセスがあった場合に、
 * その親投稿（親の投稿・固定ページ・カスタム投稿など）へリダイレクトします。
 * 親がない場合はトップページへリダイレクトします。
 *
 * ※ 通常の投稿、固定ページ、カスタム投稿には影響しません。
 */
function disable_attachment_pages() {
    // 現在のページが「添付ファイルページ（投稿タイプ: attachment）」の場合に処理を実行
    if (is_attachment()) {
        global $post;

        // 親投稿がある場合はその投稿ページへ、なければトップページへリダイレクト
        $redirect_url = $post && $post->post_parent ? get_permalink($post->post_parent) : home_url('/');

        // 301リダイレクト（恒久的な転送）
        wp_redirect($redirect_url, 301);
        exit;
    }
}
// WordPressのページ出力直前にこの処理を実行するようにフック
add_action('template_redirect', 'disable_attachment_pages');

/**
 * 添付ファイルページ（attachment）に noindex を付加する
 * ※ リダイレクトと併用しても問題なし（リダイレクトが優先）
 */
function add_noindex_to_attachment_pages() {
    if (is_attachment()) {
        echo '<meta name="robots" content="noindex, follow">';
    }
}
