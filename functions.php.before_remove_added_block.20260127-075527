/**
 * 【目的】
 * 通常 WordPress のカテゴリーページのURLは以下のような形式になります：
 *   - 親カテゴリ： https://example.com/category/genshin-impact/
 *   - 子カテゴリ： https://example.com/category/new-character/
 *
 * しかしこのままだと、親子関係がURLに反映されないため、情報構造が分かりづらくSEO的にも弱い構造になります。
 *
 * このコードでは、カスタムなリライトルールを追加することで、
 *   /example.com/genshin-impact/new-character/
 * のように「親スラッグ / 子スラッグ」というURL構造を実現します。
 *
 * 【SEO的メリット】
 * - URLから情報構造（親子カテゴリの関係）が明確に伝わる
 * - Googleにとってもコンテンツ構造が理解されやすく、インデックスやクローリング効率が良くなる
 * - ユーザーにとっても「どのジャンルの下にある記事か」がURLで一目でわかる
 *
 * 【URLリダイレクトを避ける意図】
 * - `genshin_updated` などの **カスタム投稿タイプのスラッグ** と、カテゴリーのスラッグが競合している場合、
 *    WordPressは `/category/slug/` のURLを `/slug/` へリダイレクトしてしまうことがある。
 * - これにより、**本来のアーカイブページではなく index.php が表示されてしまう**問題が発生する。
 * - 本コードでは `$exclude_slugs` にカスタム投稿スラッグを指定して、リライトルールから除外することで
 *    **アーカイブページ本来のURL（例: /genshin_updated）で正しく表示されるようにしている**。
 *
 * 【例】
 * カテゴリー構成：
 * - 親：genshin-impact（スラッグ：genshin-impact）
 * - 子：new-character（スラッグ：new-character）
 *
 * 通常URL：
 *   /category/new-character/
 *
 * このコードを使うと：
 *   /genshin-impact/new-character/ ← SEOにも正しいURL構造で、意図しないリダイレクトも防止
 */


function custom_category_rewrite_rules($wp_rewrite) {
    $rules = [];

    // 除外したいスラッグ（カスタム投稿などと競合するもの）
    $exclude_slugs = ['genshin_updated'];

    $categories = get_categories(['hide_empty' => false]);

    foreach ($categories as $category) {
        $category_nicename = $category->slug;

        // 除外リストに含まれているならスキップ
        if (in_array($category_nicename, $exclude_slugs, true)) {
            continue;
        }

        // 親カテゴリでなければ処理
        if ($category->category_parent === 0) {
            continue;
        }

        $parent = get_category($category->category_parent);

        if ($parent) {
            // 親カテゴリ自体が除外対象ならスキップ
            if (in_array($parent->slug, $exclude_slugs, true)) {
                continue;
            }

            $rules["{$parent->slug}/{$category_nicename}/?$"] =
                "index.php?category_name={$parent->slug}/{$category_nicename}";
        }
    }

    $wp_rewrite->rules = $rules + $wp_rewrite->rules;
}
add_filter('generate_rewrite_rules', 'custom_category_rewrite_rules');






