/**
 * ============================================================
 * 【目的】カテゴリ親子の投稿表示 + タグ/タクソノミーでCPTも拾う + TagCloudキャッシュ即反映
 * ============================================================
 *
 * ① 親カテゴリ（例：genshin-impact）の一覧で「子カテゴリの投稿」も一緒に表示する
 * ② /tag/xxx や /taxonomy/xxx の一覧で、通常投稿(post)だけでなく
 *    CPT（genshin_updated / genshin_updated_jp）も検索対象に含める
 * ③ サイドバーの Tag Cloud（sb_render_tag_cloud_scoped の transient）が
 *    “最大10分古いまま” になるのを防ぐため、タグ更新/投稿更新時にキャッシュを削除する
 *
 * ------------------------------------------------------------
 * 【なぜ必要？】あなたの症状
 * ------------------------------------------------------------
 * - /tag/ineffa に実際は genshin_updated の投稿があるのに No posts になる
 *   → タグアーカイブのメインクエリが post だけを検索しており、CPTが落ちている可能性が高い
 *
 * - Tag Cloud がすぐ反映されない
 *   → sb_render_tag_cloud_scoped() が transient をキャッシュ（例：10分）しているため
 *
 * ------------------------------------------------------------
 * 【このコードの原則】
 * ------------------------------------------------------------
 * - 管理画面（is_admin）は絶対に触らない
 * - “フロントのメインクエリ” だけを触る（ウィジェット等のサブクエリを壊さない）
 * - タグ/タクソノミーでは post_type を広げて CPT も拾う
 */


/**
 * ============================================================
 * 1) メインクエリ調整：カテゴリ親子 + タグ/タクソノミーにCPTを含める
 * ============================================================
 */
add_action('pre_get_posts', function (WP_Query $query) {

  // ✅ 管理画面 / メインクエリ以外は触らない（最重要）
  if (is_admin() || ! $query->is_main_query()) {
    return;
  }

  /**
   * ------------------------------------------------------------
   * 1-A) カテゴリ一覧（is_category）
   * ------------------------------------------------------------
   * 例：/genshin-impact/（親カテゴリ）
   * - 親カテゴリに直接属する投稿だけでなく
   * - 子カテゴリに属する投稿もまとめて表示する
   *
   * ※ WordPressデフォルト：親カテゴリに “直接” 属する投稿しか出ない
   */
  if ($query->is_category()) {

    $category = get_queried_object(); // WP_Term を想定

    if ($category instanceof WP_Term && ! empty($category->term_id)) {

      // 子カテゴリIDをすべて取得（配列）
      $children = get_term_children((int)$category->term_id, 'category');

      // 子があるなら、親＋子のID全部を category__in に入れる
      if (! empty($children)) {
        $all_ids = array_merge(
          [(int)$category->term_id],
          array_map('intval', (array)$children)
        );

        // メインクエリに「このカテゴリ群を含む投稿を出せ」と指示
        $query->set('category__in', $all_ids);
      }
    }

    // カテゴリ処理はここで終了（下の tag/tax を誤爆させない）
    return;
  }

  /**
   * ------------------------------------------------------------
   * 1-B) タグ一覧 / タクソノミー一覧（is_tag / is_tax）
   * ------------------------------------------------------------
   * 例：/tag/ineffa
   * ここが “No posts” を直す本体。
   *
   * ※ WordPress/テーマ次第で tag アーカイブが post だけになることがあるため、
   *    ここで検索対象 post_type を増やす。
   */
  if ($query->is_tag() || $query->is_tax()) {

    // ✅ タグ/タクソノミー一覧で拾いたい投稿タイプ（必要に応じて追加OK）
    $query->set('post_type', [
      'post',
      'genshin_updated',
      'genshin_updated_jp',
    ]);

    return;
  }

});


/**
 * ============================================================
 * 2) Tag Cloud の transient キャッシュ削除（安全版）
 * ============================================================
 *
 * sb_render_tag_cloud_scoped() は transient キーとして
 *   sb_tagcloud_{md5...}
 * を作ってキャッシュしている（例：10分）。
 *
 * だから、タグ付け替え・投稿保存・タグ編集などが起きたら
 * “sb_tagcloud_ で始まる transient” をまとめて削除する。
 *
 * ✅ delete_option を直叩きすると、Redis等の object cache 環境で消えないことがある
 * → delete_transient() を使うのが正道
 */


/**
 * sb_tagcloud_ 系 transient を全部削除する
 */
function gw_clear_sb_tagcloud_transients() {
  global $wpdb;

  // options テーブル上の transient 実体（_transient_〜）を拾う
  $like = $wpdb->esc_like('_transient_sb_tagcloud_') . '%';

  $option_names = $wpdb->get_col(
    $wpdb->prepare(
      "SELECT option_name FROM {$wpdb->options} WHERE option_name LIKE %s",
      $like
    )
  );

  if (empty($option_names)) return;

  foreach ($option_names as $opt_name) {
    // option_name: "_transient_sb_tagcloud_xxx" → transient key: "sb_tagcloud_xxx"
    $tkey = preg_replace('/^_transient_/', '', $opt_name);

    if ($tkey) {
      // ✅ timeoutも含めて、オブジェクトキャッシュでも確実に消える
      delete_transient($tkey);
    }
  }
}


/**
 * 投稿が保存されたらキャッシュ削除
 * - タグ変更も save_post に含まれることが多い（投稿画面でタグ編集した場合など）
 */
add_action('save_post', function($post_id){
  // revision/autosave は除外（無駄に消さない）
  if (wp_is_post_revision($post_id) || wp_is_post_autosave($post_id)) return;

  // 必要なら対象 post_type を絞ってもOK（例：post / genshin_updated だけ等）
  gw_clear_sb_tagcloud_transients();
}, 20);


