/**
 * Menu Item を安全な配列に変換
 */
function gw_nav_sanitize_item($it): array {
  $title = wp_strip_all_tags((string) $it->title);
  $url   = esc_url_raw((string) $it->url);

  $classes = [];
  if (!empty($it->classes) && is_array($it->classes)) {
    foreach ($it->classes as $cls) {
      $cls = sanitize_html_class((string) $cls);
      if ($cls !== '') $classes[] = $cls;
    }
    $classes = array_values(array_unique($classes));
  }

  // target/rel は “許可したものだけ” 残す（事故防止）
  $target = $it->target ? (string) $it->target : null;
  if (!in_array($target, ['_blank', '_self', '_parent', '_top'], true)) {
    $target = null;
  }

  $rel = $it->xfn ? (string) $it->xfn : null;
  if ($rel !== null) {
    $rel = trim(preg_replace('/\s+/', ' ', $rel));
    // 必要なら許可リストで絞ってもいい
  }

  return [
    'id'        => (int) $it->ID,
    'parent'    => (int) $it->menu_item_parent,
    'order'     => (int) $it->menu_order,
    'title'     => $title,
    'url'       => $url,
    'target'    => $target,
    'rel'       => $rel,
    'classes'   => $classes,
    'children'  => [],
  ];
}

/**
 * ツリー化 + ソート + 深さ制限
 */
function gw_nav_build_tree(array $flat, int $max_depth): array {
  $tree = [];

  foreach ($flat as $id => &$node) {
    $p = (int) $node['parent'];
    if ($p > 0 && isset($flat[$p])) {
      $flat[$p]['children'][] = &$node;
    } else {
      $tree[] = &$node;
    }
  }
  unset($node);

  $sort_and_limit = function (&$nodes, $depth) use (&$sort_and_limit, $max_depth) {
    usort($nodes, fn($a, $b) => ($a['order'] ?? 0) <=> ($b['order'] ?? 0));
    if ($depth >= $max_depth) {
      foreach ($nodes as &$n) { $n['children'] = []; }
      return;
    }
    foreach ($nodes as &$n) {
      if (!empty($n['children'])) $sort_and_limit($n['children'], $depth + 1);
    }
  };

  $sort_and_limit($tree, 1);
  return $tree;
}

function gw_rest_nav_json(WP_REST_Request $req) {

  $location = (string) ($req->get_param('location') ?: 'global-navigation');

  $allowed = gw_nav_allowed_locations();
  if (!in_array($location, $allowed, true)) {
    return new WP_REST_Response([
      'ok' => false,
      'error' => 'invalid_location',
      'allowed' => $allowed,
    ], 400);
  }

  $include_brand = absint($req->get_param('include_brand') ?? 1);

  $max_depth = absint($req->get_param('max_depth') ?? 3);
  if ($max_depth <= 0) $max_depth = 3;
  if ($max_depth > 5)  $max_depth = 5;

  // ✅ キャッシュ（ナビは頻繁に変わらない）
  $cache_key = 'gw_nav_' . md5($location . '|' . $include_brand . '|' . $max_depth);
  $cached = get_transient($cache_key);
  if (is_array($cached)) {
    return $cached;
  }

  $locations = get_nav_menu_locations();
  $menu_id = (int) ($locations[$location] ?? 0);

  $brand = null;
  if ($include_brand) {
    $brand = [
      'title' => wp_strip_all_tags(get_bloginfo('name')),
      'url'   => esc_url_raw(home_url('/')),
    ];
  }

  if (!$menu_id) {
    $res = [
      'ok'       => true,
      'location' => $location,
      'brand'    => $brand, // ✅ 型を揃える（null or {title,url}）
      'items'    => [],
      'note'     => 'no_menu_assigned',
    ];
    set_transient($cache_key, $res, 60); // 60秒（必要なら伸ばす）
    return $res;
  }

  $raw_items = wp_get_nav_menu_items($menu_id, ['update_post_term_cache' => false]);
  if (!is_array($raw_items)) $raw_items = [];

  $flat = [];
  foreach ($raw_items as $it) {
    $flat[(int)$it->ID] = gw_nav_sanitize_item($it);
  }

  $tree = gw_nav_build_tree($flat, $max_depth);

  $res = [
    'ok'       => true,
    'location' => $location,
    'brand'    => $brand,
    'items'    => $tree,
  ];

  set_transient($cache_key, $res, 60);
  return $res;
}



// 縦Slick（ニュースティカー）を非表示にする固定ページ判定
function gw_should_hide_vertical_ticker(): bool {
  if ( ! is_page() ) return false; // 固定ページだけ対象

  $post = get_post();
  if ( ! $post ) return false;

  $slug = get_post_field('post_name', $post); // ページのスラッグ
  if ( ! $slug ) return false;

  // 例: genshin-impact-ineffa-best-build / genshin-impact-furina-best-build 等
  return (bool) preg_match('/^genshin-impact-.*-best-build$/', $slug);
}




