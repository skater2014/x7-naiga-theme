function gwc_get_fields($prefix = '') {
    $fields = [];
    for ($i = 1; $i <= 6; $i++) {
        $fields[] = "{$prefix}Title-Text{$i}";
        $fields[] = "{$prefix}Text_Detail-{$i}";
        $fields[] = "{$prefix}Description_Detail{$i}";
        $fields[] = "{$prefix}Image{$i}";
        // ⚠️ _link は入れない → 保存処理で別に扱う
    }
    return $fields;
}

// ------------------------------
// 管理画面：入力フォーム（メタボックス内）
// ------------------------------
// 
function gwc_display_fields_table($post, $prefix = '') {
    $fields = gwc_get_fields($prefix);
    $pages  = get_pages(['post_status' => 'publish']); // 全公開ページ

    echo '<table class="form-table gwc-form-table">'; // ← クラス付与
    foreach ($fields as $field) {
        $value      = get_post_meta($post->ID, $field, true);
        $link_value = get_post_meta($post->ID, $field . '_link', true);

        echo '<tr>';
        echo '<th><label for="' . esc_attr($field) . '">' . esc_html($field) . '</label></th>';
        echo '<td>';

        // ===== 画像フィールド =====
        if (strpos($field, 'Image') !== false) {

            // コントロール群（1行）
            echo '<div class="gwc-field-controls">';
            echo '  <input type="text" name="' . esc_attr($field) . '" id="' . esc_attr($field) . '" value="' . esc_attr($value) . '" class="regular-text gwc-text">';
            echo '  <input type="button" class="button select-image" data-field="' . esc_attr($field) . '" value="Select">';
            echo '  <input type="button" class="button delete-image" data-field="' . esc_attr($field) . '" value="Delete">';

            // ページ選択
            echo '  <select name="' . esc_attr($field) . '_link" id="' . esc_attr($field) . '_link" class="gwc-select">';
            echo '    <option value="">Select a page</option>';
            foreach ($pages as $page) {
                $selected = selected((int)$link_value, (int)$page->ID, false);
                echo '    <option value="' . (int)$page->ID . '" ' . $selected . '>' . esc_html($page->post_title) . '</option>';
            }
            echo '  </select>';
            echo '</div>';

            // プレビュー（常に medium）
            echo '<div id="' . esc_attr($field) . '_preview" class="gwc-img-preview" aria-live="polite">';
            if ($value) {
                $image_url = '';
                if (is_numeric($value)) {
                    $src = wp_get_attachment_image_src((int)$value, 'medium');
                    if ($src && !empty($src[0])) $image_url = $src[0];
                } else {
                    $image_url = esc_url_raw($value);
                }

                if ($image_url) {
                    $page_url = $link_value ? get_permalink((int)$link_value) : '';
                    $img = '<img src="' . esc_url($image_url) . '" alt="" />';
                    echo $page_url ? '<a href="' . esc_url($page_url) . '" target="_blank" rel="noopener">' . $img . '</a>' : $img;
                }
            }
            echo '</div>';

        } else {
            // ===== 通常テキスト =====
            echo '<input type="text" name="' . esc_attr($field) . '" id="' . esc_attr($field) . '" value="' . esc_attr($value) . '" class="regular-text gwc-text">';
        }

        echo '</td></tr>';
    }
    echo '</table>';

    // JSは一度だけ出力
    static $media_once = false;
    if (!$media_once) {
        $media_once = true; ?>
        <script>
        jQuery(function($){
          var mediaFrames = {};
          var $root = $("#tables_meta_box");

          $root.on("click.gwc", ".select-image", function(e){
            e.preventDefault();
            var field = $(this).data("field");
            if(!field) return;

            if(!mediaFrames[field]){
              mediaFrames[field] = wp.media({
                title: "画像を選択またはアップロード",
                button: { text: "この画像を使用" },
                library: { type: "image" },
                multiple: false
              });

              mediaFrames[field].on("select", function(){
                var att = mediaFrames[field].state().get("selection").first().toJSON();
                if(!att || !att.id) return;
                $("#" + field).val(att.id);

                // medium優先（なければ元URL）
                var url = (att.sizes && att.sizes.medium) ? att.sizes.medium.url : att.url;
                var $prev = $("#" + field + "_preview");
                $prev.html(url ? "<img src='"+url+"' alt='' />" : "");
              });
            } else {
              mediaFrames[field].state().get("selection").reset();
            }
            mediaFrames[field].open();
          });

          $root.on("click.gwc", ".delete-image", function(e){
            e.preventDefault();
            var field = $(this).data("field");
            $("#" + field).val("");
            $("#" + field + "_preview").empty();
          });
        });
        </script>
    <?php }
}

