/* 前後ナビ用サムネ（アイキャッチ→動画ポスター→noimage） */
if ( ! function_exists('gw_nav_thumb_html') ) {
  function gw_nav_thumb_html( $post_id ) {
    if ( has_post_thumbnail($post_id) ) {
      $url = wp_get_attachment_image_url(get_post_thumbnail_id($post_id), 'nav-card');
      if ( $url ) {
        $url = set_url_scheme($url,'https');
        return '<img class="nav-thumb" src="'.esc_url($url).'" alt="'.esc_attr(get_the_title($post_id)).'" loading="lazy" decoding="async">';
      }
    }
    list($type, $video_id) = gw_get_video_type_id($post_id);
    if ( $type === 'youtube' && $video_id ) {
      $url = 'https://i.ytimg.com/vi/'.rawurlencode($video_id).'/hqdefault.jpg';
      return '<img class="nav-thumb" src="'.esc_url($url).'" alt="'.esc_attr(get_the_title($post_id)).'" loading="lazy" decoding="async">';
    }
    if ( $type === 'vimeo' && $video_id ) {
      $key='gw_vimeo_thumb_'.$video_id;
      $thumb = get_transient($key);
      if ( ! $thumb ) {
        $res = wp_remote_get('https://vimeo.com/api/oembed.json?url='.rawurlencode('https://vimeo.com/'.$video_id), ['timeout'=>6]);
        if ( ! is_wp_error($res) && 200 === (int) wp_remote_retrieve_response_code($res) ) {
          $data = json_decode(wp_remote_retrieve_body($res), true);
          if ( ! empty($data['thumbnail_url']) ) {
            $thumb = $data['thumbnail_url'];
            set_transient($key, $thumb, DAY_IN_SECONDS*7);
          }
        }
      }
      if ( $thumb ) {
        $thumb = set_url_scheme($thumb,'https');
        return '<img class="nav-thumb" src="'.esc_url($thumb).'" alt="'.esc_attr(get_the_title($post_id)).'" loading="lazy" decoding="async">';
      }
    }
    $noimage = set_url_scheme(get_template_directory_uri().'/images/noimage.gif','https');
    return '<img class="nav-thumb" src="'.esc_url($noimage).'" alt="" loading="lazy" decoding="async">';
  }
}

