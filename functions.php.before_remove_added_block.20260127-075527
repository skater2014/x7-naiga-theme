/**
 * ✅メインクエリに対して共通で posts_per_page 等を設定したい場合
 *
 * 注意：
 * - ここは「メインクエリ」だけに効く。
 * - あなたの search.php は new WP_Query($args) で独自に作っているので、
 *   その $search_query にはこの設定は効かない（=search.php 側で args に書いてるならそれでOK）。
 */
add_action('pre_get_posts', function($q){
  if (is_admin() || !$q->is_main_query()) return;

  // ✅検索結果（標準の search.php を使う場合の保険）
  if ($q->is_search()) {
    $q->set('posts_per_page', 10);
    $q->set('ignore_sticky_posts', true);
    return; // searchだけ別扱いならここでreturnしてOK
  }

  // ✅カテゴリ
  if ($q->is_category()) {
    $q->set('posts_per_page', 10);
    $q->set('ignore_sticky_posts', true);
    return;
  }

  // ✅カスタム投稿タイプのアーカイブ（例：/genshin_updated/）
  if ($q->is_post_type_archive()) {
    $q->set('posts_per_page', 10);
    $q->set('ignore_sticky_posts', true);
    return;
  }

  // 必要なら他（home / tag / taxonomy）も追加できる
  // if ($q->is_tag() || $q->is_tax()) { ... }

}, 9);






/**
 * AdSense 共通JSを「全ページで1回だけ」読み込む
 *
 * ✅ これは “特定の footer テンプレ” に書くのではなく、
 *    functions.php に書くことで、WordPressの仕組みで全ページへ適用されます。
 *
 * ✅ ここで読み込まれるJSは、HTMLの <ins class="adsbygoogle"> に対して動く “共通エンジン” です。
 *    各広告枠ごとに毎回このJSを読み込むのは NG（重複読み込みで不安定になる）
 *
 * ✅ `true` を指定しているので、出力位置は footer 側（wp_footerの位置）になります。
 *
 * 必須条件：
 * - テーマの footer.php（または get_footer() で呼ばれるテンプレ）に
 *   `<?php wp_footer(); ?>` が存在すること。
 *   これが無いと、footer出力が行われず、JSも出ません。
 */
add_action('wp_enqueue_scripts', function () {

  // ----------------------------
  // 1) 管理画面（wp-admin）では読み込まない
  //    ※ AdSenseはフロント表示用なので、管理画面に出す意味がない
  // ----------------------------
  if (is_admin()) {
    return;
  }

  // ----------------------------
  // 2) AdSense 共通JSを “1回だけ” 読み込む
  //    handle（識別名）を固定することで、他の場所で同じhandleを使うと重複を防げます
  // ----------------------------
  $handle = 'gw-adsbygoogle';

  // すでに読み込み予約済みなら何もしない（念のためのガード）
  if (wp_script_is($handle, 'enqueued') || wp_script_is($handle, 'done')) {
    return;
  }

  // ----------------------------
  // 3) 読み込むURL（あなたの AdSense client を指定）
  // ----------------------------
  $src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9458790149381361';

  // ----------------------------
  // 4) enqueue（読み込み予約）
  // - 第3引数：依存（今回は無し）
  // - 第4引数：バージョン（CDNなので null）
  // - 第5引数：true = footer（wp_footerの位置で読み込む）
  // ----------------------------
  wp_enqueue_script(
    $handle,
    $src,
    [],
    null,
    true
  );

  // ----------------------------
  // 5) AdSense推奨の属性 crossorigin="anonymous" を付けたい場合
  //    wp_enqueue_script だけだと属性は付かないので、フィルタで付与する
  // ----------------------------
  add_filter('script_loader_tag', function ($tag, $current_handle) use ($handle) {
    if ($current_handle !== $handle) return $tag;

    // 既に crossorigin があればそのまま
    if (stripos($tag, 'crossorigin=') !== false) return $tag;

    // <script ...> に crossorigin="anonymous" を追加
    return str_replace('<script ', '<script crossorigin="anonymous" ', $tag);
  }, 10, 2);

});


