/**
 * メタボックスの描画処理
 */
function render_japanese_link_select_meta($post) {
    // 現在保存されている日本語記事のリンクIDを取得
    $selected_id = get_post_meta($post->ID, '_japanese_link_post_id', true);

    // 保存時のセキュリティ用nonceフィールドを出力
    wp_nonce_field('save_japanese_link_select_meta', 'japanese_link_select_nonce');

    /**
     * 日本語記事（genshin_updated_jp 投稿タイプ）のみ取得
     * 
     * - post_type: genshin_updated_jp（今回作成した日本語記事用カスタム投稿タイプ）
     * - posts_per_page: -1（全件取得）
     * - orderby: title（タイトル順）
     * - order: ASC（昇順）
     */
    $jp_posts = get_posts([
        'post_type'      => ['genshin_updated_jp'],
        'posts_per_page' => -1,
        'orderby'        => 'title',
        'order'          => 'ASC'
    ]);

    // プルダウンを出力
    echo '<select name="japanese_link_post_id" style="width:100%;">';
    echo '<option value="">選択してください</option>';

    foreach ($jp_posts as $jp_post) {
        // 保存済みのIDと一致している場合は selected 属性を付与
        $selected = selected($selected_id, $jp_post->ID, false);

        // タイトルを表示（エスケープ済み）
        echo '<option value="' . esc_attr($jp_post->ID) . '" ' . $selected . '>'
            . esc_html($jp_post->post_title) . '</option>';
    }

    echo '</select>';
}


/**
 * メタボックスの保存処理
 * 
 * 記事保存時に選択された日本語記事IDを
 * カスタムフィールド `_japanese_link_post_id` に保存します。
 */
function save_japanese_link_select_meta($post_id) {
    // nonceチェック（CSRF対策）
    if (!isset($_POST['japanese_link_select_nonce']) ||
        !wp_verify_nonce($_POST['japanese_link_select_nonce'], 'save_japanese_link_select_meta')) {
        return;
    }

    // 自動保存時は何もしない
    if (defined('DOING_AUTOSAVE') && DOING_AUTOSAVE) return;

    // 編集権限のチェック
    if (!current_user_can('edit_post', $post_id)) return;

    // フォームから送信された日本語記事IDがある場合は保存、なければ削除
    if (!empty($_POST['japanese_link_post_id'])) {
        update_post_meta($post_id, '_japanese_link_post_id', intval($_POST['japanese_link_post_id']));
    } else {
        delete_post_meta($post_id, '_japanese_link_post_id');
    }
}
add_action('save_post', 'save_japanese_link_select_meta');






// sidebar-unified.php 用：サイドバー引数を作る（※ここではテンプレ呼び出ししない）
if (!function_exists('gw_sidebar_args')) {
  function gw_sidebar_args(){

    // Genshin系CPT（必要に応じて増減）
    $genshin_cpts = ['genshin_updated','genshin_updated_jp','genshin_build','artifacts'];

    // ★既定（必ずこのキーを持つ）
    $defaults = [
      'cats' => [],
      'post_types' => ['post'],
      'show_materials' => false,
      'allow_movies_fallback' => false,
      'featured_post_id' => 0,

      // ★TagCloud 用：文脈スコープ（ここが重要）
      // - post_id: 個別記事なら「その記事のタグだけ」等が可能
      // - tax: タクソ/タグアーカイブなら「そのタームに属する投稿群のタグ」にできる
      'scope' => [
        'post_id' => 0,
        'tax'     => null, // ['taxonomy'=>'xxx','field'=>'slug','terms'=>['yyy']]
      ],

      // ★TagCloud の挙動（お好み）
      // 'category' : その文脈カテゴリのタグ（tekken/genshin を分離）
      // 'post'     : その記事に付いてるタグだけ（記事別）
      // 'tax'      : タクソ/タグのタームで絞る（タクソ別）
      'tagcloud_mode' => 'category',
    ];

    $merge = function($overrides) use ($defaults){
      return wp_parse_args($overrides, $defaults);
    };

    $qo  = get_queried_object();
    $qid = (int) get_queried_object_id();

    // ─────────────────────────────
    // 1) 単一ページ（投稿・固定・CPT）
    // ─────────────────────────────
    if (is_singular() && $qid > 0) {
      $pt = get_post_type($qid);

      // ★Genshin CPT：CPTだけに絞る（カテゴリでは絞らない）
      if (in_array($pt, $genshin_cpts, true)) {
        return $merge([
          'post_types' => [$pt],
          'cats' => [],
          'show_materials' => false,
          'allow_movies_fallback' => false,

          // TagCloud：記事別にするなら post、CPT全体にするなら category に変える
          'tagcloud_mode' => 'post',
          'scope' => [
            'post_id' => $qid,
            'tax' => null,
          ],
        ]);
      }

      // 通常投稿：Genshin
      if (in_category('genshin-impact', $qid)) {
        return $merge([
          'post_types' => ['post'],
          'cats' => ['genshin-impact'],
          'show_materials' => true,
          'allow_movies_fallback' => true,

          // ★ここがポイント：
          // tekken/genshin を “記事ページでもカテゴリ別のタグクラウド” にしたいなら category
          // “その記事に付けたタグだけ”にしたいなら post
          'tagcloud_mode' => 'category',
          'scope' => [
            'post_id' => ($defaults['tagcloud_mode']==='post') ? $qid : 0,
            'tax' => null,
          ],
        ]);
      }

      // 通常投稿：Tekken
      if (in_category('tekken7', $qid)) {
        return $merge([
          'post_types' => ['post'],
          'cats' => ['tekken7'],
          'show_materials' => false,
          'allow_movies_fallback' => false,

          'tagcloud_mode' => 'category',
          'scope' => [
            'post_id' => 0,
            'tax' => null,
          ],
        ]);
      }

      // その他
      return $defaults;
    }

    // ─────────────────────────────
    // 2) カテゴリアーカイブ（tekken/genshin）
    // ─────────────────────────────
    if (is_category() && $qo instanceof WP_Term) {
      if ($qo->slug === 'genshin-impact') {
        return $merge([
          'post_types' => ['post'],
          'cats' => ['genshin-impact'],
          'show_materials' => true,
          'allow_movies_fallback' => true,
          'tagcloud_mode' => 'category',
        ]);
      }
      if ($qo->slug === 'tekken7') {
        return $merge([
          'post_types' => ['post'],
          'cats' => ['tekken7'],
          'show_materials' => false,
          'allow_movies_fallback' => false,
          'tagcloud_mode' => 'category',
        ]);
      }
    }

    // ─────────────────────────────
    // 3) CPTアーカイブ（genshin_*）
    // ─────────────────────────────
    if (is_post_type_archive($genshin_cpts)) {
      $pt = '';
      if ($qo instanceof WP_Post_Type) $pt = $qo->name;          // ←これが一番確実
      if (!$pt) {
        $tmp = get_query_var('post_type');
        $pt = is_array($tmp) ? reset($tmp) : (string)$tmp;
      }
      if (!$pt) $pt = 'genshin_updated';

      return $merge([
        'post_types' => [$pt],
        'cats' => [],
        'show_materials' => false,
        'allow_movies_fallback' => false,

        // CPT全体のタグクラウドにするなら category（cats空なので実質 post_types スコープ）
        'tagcloud_mode' => 'category',
      ]);
    }

    // ─────────────────────────────
    // 4) タグアーカイブ（is_tag）
    // ─────────────────────────────
    if (is_tag() && $qo instanceof WP_Term) {
      // post_tag が付与されてる post_type 群（CPTにも付けてるならここに入る）
      $obj = get_taxonomy('post_tag');
      $pts = !empty($obj->object_type) ? array_values((array)$obj->object_type) : ['post'];

      return $merge([
        'post_types' => $pts,
        'cats' => [],

        'tagcloud_mode' => 'tax',
        'scope' => [
          'post_id' => 0,
          'tax' => [
            'taxonomy' => 'post_tag',
            'field'    => 'slug',
            'terms'    => [$qo->slug],
          ],
        ],
      ]);
    }

    // ─────────────────────────────
    // 5) タクソノミーアーカイブ（is_tax）
    // ─────────────────────────────
    if (is_tax() && $qo instanceof WP_Term) {
      $tax = (string)$qo->taxonomy;
      $obj = get_taxonomy($tax);
      $pts = (!empty($obj) && !empty($obj->object_type)) ? array_values((array)$obj->object_type) : ['post'];

      return $merge([
        'post_types' => $pts, // ★これで “genshin_updated の taxonomy でも CPT が消えない”
        'cats' => [],

        'tagcloud_mode' => 'tax',
        'scope' => [
          'post_id' => 0,
          'tax' => [
            'taxonomy' => $tax,
            'field'    => 'slug',
            'terms'    => [$qo->slug],
          ],
        ],
      ]);
    }

    return $defaults;
  }
}





/**
 * GWC いいねAPI ＆ RESTレスポンス拡張
 * 
 * 役割：
 *  - /wp-json/gwc/v1/like で「いいね」リクエストを受け取る
 *  - 投稿メタに いいね数 / いいねしたユーザー一覧 を保存
 *  - /wp-json/wp/v2/posts などのレスポンスに gwc_like_count を含める
 */

// ================================
// ① GWC いいね API エンドポイント
// ================================

// WordPress の REST API が初期化されるタイミングで処理を追加
add_action('rest_api_init', function () {

    // /wp-json/gwc/v1/like というエンドポイントを登録
    register_rest_route('gwc/v1', '/like', [
        'methods'  => 'POST',              // HTTPメソッドは POST のみ許可
        'callback' => 'gwc_handle_like',   // 実際の処理を行う関数名
        'permission_callback' => '__return_true', 
        // ↑ 誰でも叩けるようにする（必要なら認証に変更）
    ]);

});

/**
 * いいね API のコールバック関数
 *
 * @param WP_REST_Request $req  クライアント（Flutterアプリ）からのリクエスト
 * @return array|WP_Error       レスポンス用の配列 or エラーオブジェクト
 */
function gwc_handle_like(WP_REST_Request $req) {

    // リクエストパラメータから post_id（記事ID）を整数として取得
    $post_id   = (int) $req['post_id'];

    // device_id（端末ごとの一意なID）をサニタイズして取得
    $device_id = sanitize_text_field($req['device_id']);

    // post_id か device_id が渡されていなければエラーを返す
    if (!$post_id || !$device_id) {
        return new WP_Error(
            'invalid',
            'missing post_id or device_id',
            ['status' => 400]
        );
    }

    // ---------------------------------------
    // すでに「いいね」したユーザー一覧を取得
    // 投稿メタキー： gwc_like_users（配列想定）
    // ---------------------------------------
    $users = get_post_meta($post_id, 'gwc_like_users', true);

    // まだ一度も保存されていない場合は空の配列にする
    if (!is_array($users)) {
        $users = [];
    }

    // ---------------------------------------
    // 同じ device_id がすでに含まれているかチェック
    // → 含まれていたら「二重カウントしない」
    // ---------------------------------------
    if (in_array($device_id, $users, true)) {

        // すでに like 済みの場合：現在のカウントだけ返して終了
        $count = (int) get_post_meta($post_id, 'gwc_like_count', true);

        return [
            'liked' => true,  // いいね済み
            'count' => $count // 現在の合計いいね数
        ];
    }

    // ---------------------------------------
    // ここに来たということは「初めてのいいね」
    // → device_id を一覧に追加して保存
    // ---------------------------------------
    $users[] = $device_id;

    // 投稿メタ gwc_like_users を更新
    update_post_meta($post_id, 'gwc_like_users', $users);

    // ---------------------------------------
    // いいね数 gwc_like_count を 1 増やして保存
    // ---------------------------------------
    $count = (int) get_post_meta($post_id, 'gwc_like_count', true);
    $count++; // 1加算
    update_post_meta($post_id, 'gwc_like_count', $count);

    // クライアント（Flutterアプリ）に返すレスポンス
    return [
        'liked' => true,  // 今回の操作で「いいね済み」になった
        'count' => $count // 更新後の合計いいね数
    ];
}



// ==========================================
// ② 投稿取得 API に gwc_like_count を含める
// ==========================================

// REST API 初期化時に、post にカスタムフィールドを追加
add_action('rest_api_init', function () {

    // 第1引数 'post' → 投稿タイプ post に対して
    // gwc_like_count というフィールドを追加する
    register_rest_field('post', 'gwc_like_count', [

        // APIレスポンス用の値を返す関数
        'get_callback' => function ($obj) {

            // $obj['id'] は記事ID（REST用の配列オブジェクト）
            $post_id = $obj['id'];

            // 投稿メタ gwc_like_count の値を整数として返す
            return (int) get_post_meta($post_id, 'gwc_like_count', true);
        },

        // スキーマ情報（任意だが書いておくと親切）
        'schema' => [
            'description' => 'Total like count', // 説明文
            'type'        => 'integer',          // 整数型
        ]

    ]);

});


