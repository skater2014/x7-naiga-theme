function gwc_render_table($post_id, $prefix = '') {
    $rows = [];
    for ($i = 1; $i <= 6; $i++) {
        $title   = get_post_meta($post_id, "{$prefix}Title-Text{$i}", true);
        $desc    = get_post_meta($post_id, "{$prefix}Description_Detail{$i}", true);
        $img_id  = get_post_meta($post_id, "{$prefix}Image{$i}", true);
        $text    = get_post_meta($post_id, "{$prefix}Text_Detail-{$i}", true);
        $link_id = get_post_meta($post_id, "{$prefix}Image{$i}_link", true);

        if ($title || $desc || $img_id || $text) {
            // 画像URL
            $img_url = is_numeric($img_id) ? wp_get_attachment_url((int)$img_id) : $img_id;

            // ページリンクURL（公開済みチェックあり）
            $page_url = '';
            if ($link_id && get_post_status((int)$link_id) === 'publish') {
                $page_url = get_permalink((int)$link_id);
            }

            $rows[] = compact('title','desc','img_url','text','page_url');
        }
    }

    if ($rows) {
        echo '<table class="design17 responsive-table">';
        echo '<thead><tr><th>Title</th><th>Description</th><th>Image</th><th>Text</th></tr></thead><tbody>';
        foreach ($rows as $r) {
            echo '<tr>';
            echo '<td>'.esc_html($r['title']).'</td>';
            echo '<td>'.esc_html($r['desc']).'</td>';
            echo '<td>';

            if ($r['img_url']) {
                // 画像タグ
                $img = '<img src="'.esc_url($r['img_url']).'" style="max-width:100%;height:auto;">';

                // ページリンクがあれば <a> でラップ
                if ($r['page_url']) {
                    echo '<a href="'.esc_url($r['page_url']).'" target="_blank">'.$img.'</a>';
                } else {
                    echo $img;
                }
            }

            echo '</td>';
            echo '<td>'.esc_html($r['text']).'</td>';
            echo '</tr>';
        }
        echo '</tbody></table>';
    }
}


