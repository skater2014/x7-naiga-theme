/**
 * 【目的】
 * この関数は、WordPressにおけるAjax通信を使って、
 * 「genshin-impact」カテゴリーの投稿を非同期で取得・表示するための処理です。
 *
 * 主に「もっと見る」ボタンや無限スクロールなどのUIで、
 * ページをリロードせずに投稿を追加読み込みしたい場面で使います。
 *
 * クライアント（JavaScript）側から `POST` で `page` パラメータを送ることで、
 * 指定ページの投稿10件を取得し、HTMLで返します。
 */

// Ajaxリクエスト用の処理
function custom_ajax_handler() {
    // ページ番号の取得（JavaScriptから送られてくる）
    $paged = isset($_POST['page']) ? intval($_POST['page']) : 1;

    // WP_Queryを使用して、新しいページの「genshin-impact」投稿を取得
    $genshin_impact_query = new WP_Query(array(
        'category_name' => 'genshin-impact', // 対象カテゴリーのスラッグ
        'posts_per_page' => 10,               // 1ページあたりの表示件数
        'paged' => $paged                     // ページ番号で取得位置を変更
    ));

    // 投稿が存在する場合はループで表示
    if ($genshin_impact_query->have_posts()) :
        while ($genshin_impact_query->have_posts()) : $genshin_impact_query->the_post();
            // 投稿の表示部分（HTMLとして出力）
            // 例:
            echo '<div class="post-item">';
            echo '<h2><a href="' . get_permalink() . '">' . get_the_title() . '</a></h2>';
            echo '</div>';
        endwhile;
        wp_reset_postdata();
    else :
        // 投稿がなかった場合の出力
        echo '<p>No posts found.</p>';
    endif;

    // 処理を終了（Ajax通信では必須）
    wp_die();
}

// ログインユーザー向けのAjaxアクション登録
add_action('wp_ajax_custom_ajax_handler', 'custom_ajax_handler');

// 非ログインユーザー向けのAjaxアクション登録
add_action('wp_ajax_nopriv_custom_ajax_handler', 'custom_ajax_handler');




