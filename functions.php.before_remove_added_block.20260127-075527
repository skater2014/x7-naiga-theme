    // Traveler/主人公はそもそも出さない
    if (gw_is_traveler_family($display)) return null;

    // 元素推定
    $element = '';
    $elem_raw = strtolower(trim((string) get_post_meta($pid, '_gwc_element_key', true)));
    if ($elem_raw && preg_match('/^(anemo|cryo|dendro|electro|geo|hydro|pyro)$/', $elem_raw)) {
      $element = $elem_raw;
    }
    if ($element === '') {
      $elem_icon_meta = (string) get_post_meta($pid, '_gwc_element_icon', true);
      if ($elem_icon_meta && preg_match('#element_(anemo|cryo|dendro|electro|geo|hydro|pyro)\.png#i', $elem_icon_meta, $m)) {
        $element = strtolower($m[1]);
      }
    }
    if ($element === '') $element = 'anemo';

    $weapon = trim((string) get_post_meta($pid, '_gwc_weapon_type', true));
    $weapon = ($weapon !== '') ? ucfirst(strtolower($weapon)) : 'Sword';

$rarity_meta = (int) get_post_meta($pid, '_gwc_char_rarity', true);
$rarity_meta = ($rarity_meta === 4 || $rarity_meta === 5) ? (string)$rarity_meta : '5';
$rarity_class = 'rarity-' . $rarity_meta;


    $element_icon = trim((string) get_post_meta($pid, '_gwc_element_icon', true));
    if ($element_icon === '') {
      $element_icon = trailingslashit(get_template_directory_uri()) .
                      'images/genshin/Characters/Element_' . ucfirst($element) . '.png';
    }

    $alt_text = 'Genshin Impact ' . $display . ' Build';

    $tier = strtoupper(trim((string) get_post_meta($pid, '_gwc_tier', true)));
    if (!in_array($tier, ['S','A','B','C','D'], true)) $tier = '';

    $link = $override_link ?: get_permalink($pid);

    return [
      'name'         => $display,
      'raw_name'     => $raw_name,
      'element'      => $element,
      'rarity'       => $rarity_class,
      'weapon'       => $weapon,
      'icon'         => $portrait,
      'element_icon' => $element_icon,
      'link'         => $link,
      'alt'          => $alt_text,
      'tier'         => $tier,
      'id'           => $pid,
    ];
  }
}

// 文字列から要素キーを推定（element_icon URLから抜く）
function gwc_guess_element_key_from_icon_url($url){
  $url = (string)$url;
  if ($url === '') return '';
  if (preg_match('~(anemo|cryo|dendro|electro|geo|hydro|pyro)~i', $url, $m)) {
    return strtolower($m[1]);
  }
  return '';
}

// 表示名を作る（"Genshin Impact Ayaka Build" → "Ayaka"）
function gwc_clean_character_display_name($raw){
  $s = trim((string)$raw);
  if ($s === '') return '';
  $s = preg_replace('~^Genshin Impact\s*~i', '', $s);
  $s = preg_replace('~\s*(?:Best\s*)?Build\s*$~i', '', $s);
  $s = trim($s);
  return $s;
}

// ★ここが一覧の本体：メタからカード配列を作る
function get_genshin_characters(){
  $cards = [];

  $q = new WP_Query([
    'post_type'      => ['genshin_build','page'],   // page を一覧に含めないなら genshin_build だけにする
    'post_status'    => 'publish',
    'posts_per_page' => -1,
    'fields'         => 'ids',

    // ★このメタがあるものだけ＝プラグインで作ったビルドだけ拾う
    'meta_query'     => [
      [
        'key'     => '_gwc_portrait',
        'compare' => 'EXISTS',
      ],
    ],
  ]);

  foreach ($q->posts as $pid) {
    $portrait = (string) get_post_meta($pid, '_gwc_portrait', true);
    if ($portrait === '') continue;

    $rarity = (int) get_post_meta($pid, '_gwc_char_rarity', true);
    if ($rarity !== 4 && $rarity !== 5) $rarity = 5;

    $element_icon = (string) get_post_meta($pid, '_gwc_element_icon', true);
    $weapon_type  = (string) get_post_meta($pid, '_gwc_weapon_type', true);
    $char_name    = (string) get_post_meta($pid, '_gwc_char_name', true);

    // 表示名：メタ優先 → タイトル
    $display = gwc_clean_character_display_name($char_name);
    if ($display === '') $display = gwc_clean_character_display_name(get_the_title($pid));
    if ($display === '') $display = get_the_title($pid);

    // filter用：element/rarity/weapon
    $element_key = gwc_guess_element_key_from_icon_url($element_icon); // electro 等
    $weapon_key  = strtolower(trim($weapon_type));                     // sword 等

    $key = sanitize_title($display); // ざっくり一意キー

    $cards[$key] = [
      'id'           => $pid,
      'name'         => $display,
      'raw_name'     => $display,
      'link'         => get_permalink($pid),

      // ここがテンプレが読む値
      'icon'         => $portrait,                  // キャラアイコンとして使う
      'element_icon' => $element_icon,
      'element'      => $element_key,               // "electro"（JSフィルタ用）
      'weapon'       => $weapon_key ?: $weapon_type, // "sword"（JSフィルタ用）
      'rarity'       => 'rarity-'.$rarity,          // "rarity-5"
      'alt'          => 'Genshin Impact '.$display.' Build',
    ];
  }

  // 表示名でソート
  uasort($cards, function($a,$b){
    return strnatcasecmp($a['name'], $b['name']);
  });

  return $cards;
}


