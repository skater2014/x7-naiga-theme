/**
 * =========================================================
 * Slider Items (Image + YouTube)　　投稿記事
 * - meta:   _slider_items  (mixed items: image/youtube)
 * - legacy: _slider_images (images only, compatibility)
 * =========================================================
 */

const GW_SLIDER_META_ITEMS         = '_slider_items';
const GW_SLIDER_META_LEGACY_IMAGES = '_slider_images';

/** ---------------------------------------------------------
 * YouTube ID 抽出（URLでもID直入力でもOK）
 * --------------------------------------------------------- */
function gw_extract_youtube_id($raw) {
  $raw = trim((string)$raw);
  if ($raw === '') return '';

  // ID直入力（11文字）
  if (preg_match('/^[a-zA-Z0-9_-]{11}$/', $raw)) return $raw;

  // URLから拾う
  $patterns = [
    '/[?&]v=([a-zA-Z0-9_-]{11})/',
    '#youtu\.be/([a-zA-Z0-9_-]{11})#',
    '#/shorts/([a-zA-Z0-9_-]{11})#',
    '#/embed/([a-zA-Z0-9_-]{11})#',
  ];
  foreach ($patterns as $re) {
    if (preg_match($re, $raw, $m)) return $m[1];
  }
  return '';
}

/** ---------------------------------------------------------
 * items 正規化（legacy _slider_images も吸収）
 * --------------------------------------------------------- */
function gw_get_slider_items($post_id) {
  $items = get_post_meta($post_id, GW_SLIDER_META_ITEMS, true);

  if (is_array($items) && !empty($items)) {
    $out = [];
    foreach ($items as $it) {
      $type = $it['type'] ?? '';
      if ($type === 'youtube') {
        $id = gw_extract_youtube_id($it['id'] ?? '');
        if ($id) $out[] = ['type'=>'youtube','id'=>$id];
      } elseif ($type === 'image') {
        $url = trim((string)($it['url'] ?? ''));
        if ($url) $out[] = ['type'=>'image','url'=>$url];
      }
    }
    return $out;
  }

  // legacy fallback（画像だけ）
  $imgs = get_post_meta($post_id, GW_SLIDER_META_LEGACY_IMAGES, true);
  if (is_array($imgs) && !empty($imgs)) {
    return array_values(array_filter(array_map(function ($u) {
      $u = trim((string)$u);
      return $u ? ['type'=>'image','url'=>$u] : null;
    }, $imgs)));
  }

  return [];
}

/** ---------------------------------------------------------
 * ① フロント：スライダーHTML出力（JSは書かない）
