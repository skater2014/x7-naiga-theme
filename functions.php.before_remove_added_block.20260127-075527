/* ============================================================
 * 2) Latest_Posts_Widget 本体（内部で WP_Query）
 * ============================================================ */
class Latest_Posts_Widget extends WP_Widget
{
    function __construct()
    {
        parent::__construct(
            'latest_posts_widget',
            __('Latest Posts Widget', 'text_domain'),
            array('description' => __('Display latest posts with thumbnails', 'text_domain'))
        );
    }

    public function widget($args, $instance)
    {
        echo $args['before_widget'];

        $title = isset($instance['title']) ? $instance['title'] : 'Latest Posts';
        echo $args['before_title']
            . '<div class="widgettitle custom-widget-title side-title">'
            . esc_html(apply_filters('widget_title', $title))
            . '</div>'
            . $args['after_title'];

        $number = !empty($instance['number_of_posts']) ? (int)$instance['number_of_posts'] : 5;
        $cat    = !empty($instance['category_name']) ? sanitize_title($instance['category_name']) : '';

        $q_args = array(
            'posts_per_page'      => $number,
            'ignore_sticky_posts' => true,
        );
        if (!empty($cat)) {
            $q_args['category_name'] = $cat;
        }

        $q = new WP_Query($q_args);

        if ($q->have_posts()) {
            echo '<div class="custom-widget-container">';

            $count = 0;
            while ($q->have_posts()) {
                $q->the_post();

                echo '<div class="custom-widget-item" style="width:50%;float:left;height:200px;">';

                if (has_post_thumbnail()) {
                    echo '<a href="' . esc_url(get_permalink()) . '" title="' . esc_attr(get_the_title()) . '">';
                    echo '<img width="150" height="100" src="' . esc_url(get_the_post_thumbnail_url(get_the_ID(), 'home-thumb')) . '" class="attachment-home-thumb size-home-thumb wp-post-image" alt="" decoding="async" loading="lazy">';
                    echo '</a>';
                }

                echo '<a href="' . esc_url(get_permalink()) . '" title="' . esc_attr(get_the_title()) . '">'
                    . esc_html(get_the_title())
                    . '</a>';

                echo '</div>';

                $count++;
                if ($count % 2 === 0) echo '<div style="clear: both;"></div>';
            }

            echo '</div>';
        } else {
            echo '<p>No posts found</p>';
        }

        wp_reset_postdata();
        echo $args['after_widget'];
    }

    public function form($instance)
    {
        $title  = !empty($instance['title']) ? $instance['title'] : 'Latest Posts';
        $number = !empty($instance['number_of_posts']) ? (int)$instance['number_of_posts'] : 5;
        $cat    = !empty($instance['category_name']) ? $instance['category_name'] : '';
        ?>
        <p>
            <label for="<?php echo $this->get_field_id('title'); ?>">Title:</label>
            <input class="widefat"
                id="<?php echo $this->get_field_id('title'); ?>"
                name="<?php echo $this->get_field_name('title'); ?>"
                type="text"
                value="<?php echo esc_attr($title); ?>">
        </p>
        <p>
            <label for="<?php echo $this->get_field_id('category_name'); ?>">Category slug:</label>
            <input class="widefat"
                id="<?php echo $this->get_field_id('category_name'); ?>"
                name="<?php echo $this->get_field_name('category_name'); ?>"
                type="text"
                value="<?php echo esc_attr($cat); ?>"
                placeholder="genshin-impact / tekken7">
        </p>
        <p>
            <label for="<?php echo $this->get_field_id('number_of_posts'); ?>">Number of posts:</label>
            <input class="widefat"
                id="<?php echo $this->get_field_id('number_of_posts'); ?>"
                name="<?php echo $this->get_field_name('number_of_posts'); ?>"
                type="number"
                value="<?php echo esc_attr($number); ?>" min="1" max="10">
        </p>
        <?php
    }

    public function update($new_instance, $old_instance)
    {
        return array(
            'title'           => !empty($new_instance['title']) ? sanitize_text_field($new_instance['title']) : '',
            'category_name'   => !empty($new_instance['category_name']) ? sanitize_title($new_instance['category_name']) : '',
            'number_of_posts' => !empty($new_instance['number_of_posts']) ? (int)$new_instance['number_of_posts'] : 5,
        );
    }
}


/* ============================================================
 * 3) 本体：my_custom_menu（header.php と REST で共通）
 *
 * header.php では： my_custom_menu();
 * REST では：      my_custom_menu(true, 'genshin-impact'); など
 * ============================================================ */
function my_custom_menu($allow_rest = false, $force_slug = '')
{
    // ✅ REST中は通常は出さない（allow_rest=true なら出す）
    if (function_exists('wp_doing_rest') && wp_doing_rest() && !$allow_rest) {
        return;
    }
    // wp_doing_rest() が無い環境の保険
    if (defined('REST_REQUEST') && REST_REQUEST && !$allow_rest) {
        return;
    }

    global $wp;

    // 1) slug 決定（RESTは force_slug を使う）
    $page_slug = '';

    if (!empty($force_slug)) {
        $page_slug = sanitize_title($force_slug);
    } else {
        // 通常表示：今見てるURLパスから判定
        $path = isset($wp->request) ? '/' . ltrim($wp->request, '/') : '';

        if (strpos($path, '/genshin-impact') !== false) {
            $page_slug = 'genshin-impact';
        } elseif (strpos($path, '/tekken7') !== false) {
            $page_slug = 'tekken7';
        } else {
            $page_slug = '';
        }
    }

    // 2) サイドメニュー（nav）
    wp_nav_menu(array(
        'theme_location' => 'side-menu',
        'menu'           => 'side-menu',
        'menu_id'        => 'header-navigation',
        'container'      => 'div',
        'items_wrap'     => '<ul class="%2$s sidebar-dropdown-menu">%3$s</ul>',
        'depth'          => 3,
    ));

    // 3) 検索フォーム
    echo '<div class="mobile-search" style="padding-left: 60px">';
    include get_template_directory() . '/searchform30.php';
    echo '</div>';

    // 4) 最新投稿（カテゴリ別）を Widget で表示
    the_widget(
        'Latest_Posts_Widget',
        array(
            'title'           => 'Latest Posts',
            'category_name'   => $page_slug, // ← genshin-impact / tekken7
            'number_of_posts' => 5,
        ),
        array(
            'before_widget' => '<div class="widget latest-posts">',
            'after_widget'  => '</div>',
        )
    );
}


/* ============================================================
 * 4) REST：サイドドロワー HTML を返す
 *
 * 使い方（Next.js側から必ず slug 渡せ）：
 * /wp-json/gw/v1/side-drawer-html?slug=genshin-impact
 * /wp-json/gw/v1/side-drawer-html?slug=tekken7
 * ============================================================ */
add_action('rest_api_init', function () {
    register_rest_route('gw/v1', '/side-drawer-html', array(
        'methods'             => 'GET',
        'callback'            => 'gw_rest_side_drawer_html',
        'permission_callback' => '__return_true',
        'args' => array(
            'slug' => array(
                'required' => false,
                'sanitize_callback' => 'sanitize_title',
            ),
        ),
    ));
});

function gw_rest_side_drawer_html(WP_REST_Request $request)
{
    $slug = (string)$request->get_param('slug');

    ob_start();

    echo '<div class="sidebar-navigation drawer">';

    // header.php と同じ：ウィジェットエリア（使ってるなら）
    if (is_active_sidebar('custom-widget-area')) {
        dynamic_sidebar('custom-widget-area');
    }

    // ✅ RESTでも出力する（allow_rest=true + slug渡し）
    my_custom_menu(true, $slug);

    echo '</div>';

    return array(
        'html' => ob_get_clean(),
    );
}

// ----------------------------------------------------
// ① カスタムテンプレートをテンプレート選択肢に追加
// 管理画面の「固定ページ」編集時に、
// 指定フォルダ内のテンプレートファイルを選択肢として表示させるための処理
// ----------------------------------------------------
function custom_template_directory($templates)
{
    $theme_dir = get_template_directory(); // 現在のテーマディレクトリの絶対パスを取得

    // カスタムテンプレートを配置しているディレクトリのリスト
    $custom_template_dirs = array(
        $theme_dir . '/templates/character/genshin',
        $theme_dir . '/templates/character/tekken',
        $theme_dir . '/templates/',
    );

    foreach ($custom_template_dirs as $custom_template_dir) {
        // ディレクトリが存在しない場合はスキップ
        if (!is_dir($custom_template_dir)) {
            continue;
        }

        // ディレクトリ内のファイル一覧を取得
        $template_files = scandir($custom_template_dir);

        foreach ($template_files as $file) {
            // PHPファイルのみ処理する
            if (pathinfo($file, PATHINFO_EXTENSION) === 'php') {
                // テンプレートパスを相対パスに変換してテンプレート配列に追加
                $relative_path = str_replace($theme_dir . '/', '', $custom_template_dir) . '/' . $file;
                $templates[$relative_path] = $file;
            }
        }
    }

    return $templates;
}
add_filter('theme_page_templates', 'custom_template_directory'); // 固定ページのテンプレート選択肢に追加

// ----------------------------------------------------
// ② WordPress REST API にカスタムエンドポイントを追加
// フロント側（例：FullCalendarなど）で記事データをJSONとして取得するため
// URL例：https://example.com/wp-json/custom/v1/events
// ----------------------------------------------------
function get_post_events($request)
{
    // 取得する投稿の条件を設定
    $args = array(
        'post_type'      => 'post',        // 投稿タイプ（必要に応じて 'house' などに変更）
        'posts_per_page' => -1,            // 全件取得
        'post_status'    => 'publish'      // 公開済みのみ対象
    );

    $posts = get_posts($args); // 投稿を取得
    $events = [];

    foreach ($posts as $post) {
        $events[] = array(
            'title' => get_the_title($post),                 // 投稿タイトル
            'date'  => get_the_date('Y-m-d', $post),         // 投稿日付（FullCalendar対応形式）
            'link'  => get_permalink($post),                 // 投稿へのリンク
        );
    }

    return rest_ensure_response($events); // REST APIのレスポンス形式で返す
}

// REST APIエンドポイントの登録
add_action('rest_api_init', function () {
    register_rest_route('custom/v1', '/events', array(
        'methods'             => 'GET',              // HTTPメソッド
        'callback'            => 'get_post_events',  // データ取得関数
        'permission_callback' => '__return_true',    // 誰でもアクセス可能に設定
    ));
});




