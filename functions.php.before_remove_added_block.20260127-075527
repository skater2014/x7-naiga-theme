/* 最近の“動画つき”投稿を集める（genshin_updated 優先 → post） */
if ( ! function_exists('gw_collect_recent_videos') ) {
  function gw_collect_recent_videos( $count = 5 ) {
    $collected = [];
    // genshin_updated
    $q1 = new WP_Query([
      'post_type'      => ['genshin_updated'],
      'posts_per_page' => $count * 2,
      'no_found_rows'  => true,
      'ignore_sticky_posts' => true,
      'meta_query' => [
        'relation' => 'OR',
        ['key'=>'page_featured_type', 'compare'=>'EXISTS'],
        ['key'=>'page_video_id',     'compare'=>'EXISTS'],
      ],
    ]);
    foreach ( $q1->posts as $p ) {
      if ( gw_has_video($p->ID) ) { $collected[] = $p; if (count($collected)>=$count) break; }
    }
    wp_reset_postdata();

    // post で補完
    if ( count($collected) < $count ) {
      $need = $count - count($collected);
      $q2 = new WP_Query([
        'post_type'      => ['post'],
        'posts_per_page' => $need * 2,
        'no_found_rows'  => true,
        'ignore_sticky_posts' => true,
        'meta_query' => [
          'relation' => 'OR',
          ['key'=>'page_featured_type', 'compare'=>'EXISTS'],
          ['key'=>'page_video_id',     'compare'=>'EXISTS'],
        ],
      ]);
      foreach ( $q2->posts as $p ) {
        if ( gw_has_video($p->ID) ) { $collected[] = $p; if (count($collected)>=$count) break; }
      }
      wp_reset_postdata();
    }
    return array_slice($collected, 0, $count);
  }
}


