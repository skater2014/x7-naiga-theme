//手順1,　wordpress 管理画面パーマリンク　カテゴリー非表示　/%postname%/　→　投稿やページのスラッグだけが URL に表示
//手順2, 下記のコードを作成。カテゴリーページのURLから
//手順3, index.php 複製したcategory.php 作成　カテゴリーのタイトルに合わせた固定ページでカテゴリ用のテンプレレートを読み込ませる。
//手順4, 必ずwordpress 管理画面パーマリンク設定ボタンを保存する
//カテゴリーページのURLから /category/ が取り除かれ、よりクリーンでシンプルなURLが実現
//手順5, 必ず下記のコードの動作をパーマリンク設定を教えてcategory url 消えたか確認する。　
// レンタルサーバーでの設定は関係ない。wordpress 管理画面で完結


/**
 * カテゴリURLから /category/ を消して /{slug}/ に見せるための処理（安全版）
 *
 * やっていること：
 * 1) category_link フィルタで、カテゴリリンクの見た目から /category/ を除去する
 * 2) category_rewrite_rules で、/{slug}/ を category_name に解決できるルールを追加する
 *
 * やらないこと（重要）：
 * - extra_permastructs['category']['struct'] = '%category%' のように、
 *   WPのカテゴリ構造そのものを “ベース無し” に変更しない
 *   → これをやると (. + ?)/?$ みたいな広域ルールが出て投稿/CPTが死にやすい
 */

/** 1) 表示するカテゴリURLから /category/ を消す（リンク出力だけ） */
add_filter('category_link', function($link, $term_id){
  return str_replace('/category/', '/', $link);
}, 10, 2);

/**
 * 2) /{slug}/ をカテゴリとして解決できるようにする（限定ルール）
 * - 実在するカテゴリslugだけを列挙してルールを作るので、誤爆しにくい
 * - /{slug}/page/2 なども対応
 */
add_filter('category_rewrite_rules', function($rules){
  $new  = [];
  $cats = get_categories(['hide_empty' => false]);

  foreach ($cats as $cat) {
    // slug（階層カテゴリの場合は parent/child の形にする）
    $path = $cat->slug;
    if ($cat->parent) {
      $path = trim(get_category_parents($cat->parent, false, '/', true), '/') . '/' . $path;
    }

    // /{category}/
    $new["({$path})/?$"] = 'index.php?category_name=$matches[1]';

    // /{category}/page/2
    $new["({$path})/page/?([0-9]{1,})/?$"] = 'index.php?category_name=$matches[1]&paged=$matches[2]';

    // /{category}/feed
    $new["({$path})/(feed|rdf|rss|rss2|atom)/?$"] = 'index.php?category_name=$matches[1]&feed=$matches[2]';
  }

  // 既存ルールより「先に」評価させたいので前に足す
  return $new + $rules;
});





