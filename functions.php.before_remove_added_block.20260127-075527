/*******************************************************
 * GameWidth – Genshin Characters Helpers (FULL REWRITE)
 * -----------------------------------------------------
 * 目的
 *  - キャラビルド一覧データを生成してテンプレ側で描画
 *  - 遷移先リンクの優先度：
 *      1) 固定ページ（キャラ用テンプレ付き）＞ 2) 通常固定ページ
 *      ＞ 3) カスタム投稿（genshin_build）＞ 4) レガシー推測URL
 *  - 別名の統合（Childe→Tartaglia, Raiden→Raiden Shogun 等）
 *  - Traveler/主人公（aether/lumine/traveler/主人公）は一覧に出さない
 *******************************************************/

if (!defined('ABSPATH')) exit;

/* ===============================
 * 基本ヘルパ
 * =============================== */

/** 任意文字列→安全なスラッグ */
if (!function_exists('gw_slug')) {
  function gw_slug($s){
    $s = strtolower((string)$s);
    $s = preg_replace('/[^a-z0-9]+/', '-', $s);
    $s = trim($s, '-');
    $s = preg_replace('/-+/', '-', $s);
    return $s;
  }
}

/** タイトル整形（Genshin/Impact/(Best) Build などを除去） */
if (!function_exists('gw_clean_title')) {
  function gw_clean_title($s){
    $s = preg_replace('/\b(genshin|impact)\b/i','', (string)$s);
    $s = preg_replace('/\b(best)?\s*build\b/i','', $s);
    $s = preg_replace('/\s+/',' ', trim($s));
    return $s;
  }
}

/** 別名→正式名の正規化マップ */
if (!function_exists('gw_alias_map')) {
  function gw_alias_map(){
    return [
      // 同一人物の別名を統合
      'childe'            => 'tartaglia',

      // ★ Raiden 系はすべて 'raiden' に統一
      'raiden'            => 'raiden',
      'raiden shogun'     => 'raiden',
      'raiden shougun'    => 'raiden',   // ← 綴り違いも吸収
      '雷電将軍'              => 'raiden',
      'shogun'            => 'raiden',

      // Kujou Sara 系
      'sara'              => 'kujou sara',

      // Traveler 系は全て traveler に寄せ、後段で除外
      'aether'            => 'traveler',
      'lumine'            => 'traveler',
      '主人公'                => 'traveler',
      'traveler (anemo)'   => 'traveler',
      'traveler (geo)'     => 'traveler',
      'traveler (electro)' => 'traveler',
      'traveler (dendro)'  => 'traveler',
    ];
  }
}


/** 表示名→正規化表示名（別名統合 + 余計語除去） */
if (!function_exists('gw_to_canonical_name')) {
  function gw_to_canonical_name($s){
    $s = gw_clean_title($s);
    $lower = strtolower(trim($s));
    $map   = gw_alias_map();
    if (isset($map[$lower])) $s = $map[$lower];
    return trim(preg_replace('/\s+/', ' ', $s));
  }
}

/** Traveler/主人公 判定（一覧から除外） */
if (!function_exists('gw_is_traveler_family')) {
  function gw_is_traveler_family($name){
    $n = strtolower($name);
    return in_array($n, ['traveler','主人公'], true);
  }
}

/** char key（重複排除キー）：正規化→スラッグ */
if (!function_exists('gw_char_key')) {
  function gw_char_key($s){
    return gw_slug(gw_to_canonical_name($s));
  }
}

/* ===============================
 * 補助: 固定ページ存在チェック（/genshin-impact-<name>-best-build/）
 * =============================== */
if (!function_exists('gw_find_gi_build_page_id')) {
  function gw_find_gi_build_page_id($slug_name){
    $slug_full = 'genshin-impact-' . $slug_name . '-best-build';
