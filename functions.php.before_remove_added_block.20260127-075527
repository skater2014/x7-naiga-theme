add_action('rest_api_init', function () {
  register_rest_route('gwc/v1', '/contact', [
    'methods'  => 'POST',
    'callback' => 'gwc_contact_submit',
    'permission_callback' => '__return_true', // 誰でも送れる（＝スパム対策必須）
  ]);
});

function gwc_contact_submit(WP_REST_Request $req) {
  $name    = sanitize_text_field($req->get_param('name'));
  $email   = sanitize_email($req->get_param('email'));
  $message = sanitize_textarea_field($req->get_param('message'));
  $device  = sanitize_text_field($req->get_param('device_id'));

  // ✅ 必須チェック
  if (!$name || !$email || !$message) {
    return new WP_REST_Response(['ok'=>false, 'error'=>'missing_fields'], 400);
  }
  if (!is_email($email)) {
    return new WP_REST_Response(['ok'=>false, 'error'=>'invalid_email'], 400);
  }

  // ✅ 超簡易レート制限（同device_idで60秒に1回）
  if ($device) {
    $key = 'gwc_contact_rl_' . md5($device);
    if (get_transient($key)) {
      return new WP_REST_Response(['ok'=>false, 'error'=>'rate_limited'], 429);
    }
    set_transient($key, 1, 60);
  }
  // ✅（推奨）Akismet / reCAPTCHA を入れるならここで検証
  // ※ reCAPTCHAは「トークンを受け取ってサーバーでGoogleに照会」する。アプリに秘密鍵を入れない。

  // ✅ メール送信（あなたの受信用アドレスに届く）
  $to = get_option('admin_email'); // もしくは固定の受信アドレス
  $subject = '[GameWidth Contact] ' . $name;
  $body = "Name: $name\nEmail: $email\nDevice: $device\n\n$message\n";
  $headers = ['Reply-To: ' . $email];

  $sent = wp_mail($to, $subject, $body, $headers);

  if (!$sent) {
    return new WP_REST_Response(['ok'=>false, 'error'=>'mail_failed'], 500);
  }

  return new WP_REST_Response(['ok'=>true], 200);
}





