// PCだけ／home と genshin-impact-*-best-build だけ表示
function gw_should_show_ad_rails() {
  if ( wp_is_mobile() ) return false; // PCのみ
  if ( is_admin() )     return false;

  // 投稿一覧（home.php）
  if ( is_home() ) return true;

  // 個別ページ：スラッグが genshin-impact-*-best-build
  if ( is_singular() ) {
    $slug = get_post_field('post_name', get_queried_object_id());
    if ( $slug && preg_match('/^genshin-impact-[a-z0-9-]+-best-build$/i', $slug) ) return true;
  }
  return false;
}

