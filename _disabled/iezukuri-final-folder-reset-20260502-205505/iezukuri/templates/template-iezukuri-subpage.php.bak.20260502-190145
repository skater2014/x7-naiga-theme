<?php
/*
Template Name: Construction Hub Sub Page
Template Post Type: page
*/

if (!defined('ABSPATH')) {
    exit;
}

/**
 * =========================================================
 * 基本情報
 * =========================================================
 */
$post_id       = get_the_ID();
$post_slug     = get_post_field('post_name', $post_id);
$template_key  = trim((string) get_post_meta($post_id, '_ch_subpage_template', true));
$title         = get_the_title($post_id);

/**
 * =========================================================
 * hero メタ
 * =========================================================
 */
$hero_kicker = trim((string) get_post_meta($post_id, '_ch_hero_kicker', true));
if ($hero_kicker === '') {
    $hero_kicker = 'CUSTOM HOME HUB';
}

$hero_title = trim((string) get_post_meta($post_id, '_ch_hero_title', true));
if ($hero_title === '') {
    $hero_title = $title;
}

$lead = trim((string) get_post_meta($post_id, '_ch_hero_lead', true));
if ($lead === '' && has_excerpt($post_id)) {
    $lead = get_the_excerpt($post_id);
}

$hero_image_id = (int) get_post_meta($post_id, '_ch_hero_image_id', true);
$hero_image    = $hero_image_id ? wp_get_attachment_image_url($hero_image_id, 'full') : '';

if (!$hero_image && function_exists('naigai_ch_get_subpage_hero_fallback_url')) {
    $hero_image = naigai_ch_get_subpage_hero_fallback_url($post_id, $template_key);
}

if (!$hero_image) {
    $hero_image = get_the_post_thumbnail_url($post_id, 'full');
}

$hero_video_mp4_id = (int) get_post_meta($post_id, '_ch_hero_video_mp4_id', true);
$hero_video_mp4    = $hero_video_mp4_id ? wp_get_attachment_url($hero_video_mp4_id) : '';

$hero_gallery_raw = trim((string) get_post_meta($post_id, '_ch_hero_gallery_ids', true));
$hero_gallery_ids = array_values(array_filter(array_map('absint', preg_split('/[\s,]+/', $hero_gallery_raw))));
$hero_gallery_images = array();

foreach ($hero_gallery_ids as $gallery_image_id) {
    $gallery_image_url = wp_get_attachment_image_url($gallery_image_id, 'full');

    if ($gallery_image_url) {
        $hero_gallery_images[] = array(
            'id'  => $gallery_image_id,
            'url' => $gallery_image_url,
        );
    }
}


$parent_url = trim((string) get_post_meta($post_id, '_ch_back_url', true));
if ($parent_url === '') {
    $parent_url = home_url('/iezukuri/');
}

$contact_url = trim((string) get_post_meta($post_id, '_ch_contact_url', true));
if ($contact_url === '') {
    $contact_url = home_url('/iezukuri/contact/');
}

$hero_primary_label = trim((string) get_post_meta($post_id, '_ch_hero_primary_label', true));
if ($hero_primary_label === '') {
    $hero_primary_label = '無料相談・資料請求';
}

$hero_secondary_label = trim((string) get_post_meta($post_id, '_ch_hero_secondary_label', true));
if ($hero_secondary_label === '') {
    $hero_secondary_label = '注文住宅トップへ戻る';
}

/**
 * =========================================================
 * 共通CSS
 * =========================================================
 */
if ($post_slug === 'nasu-house') {

    $nasu_css_abs = get_template_directory() . $nasu_css_rel;


    $extra_css_abs = get_template_directory() . $extra_css_rel;


}

/**
 * =========================================================
 * 本文テンプレート
 * メタキー優先
 * =========================================================
 */
$template_map = array(
    'concept'       => get_template_directory() . '/iezukuri/templates/page-concept.php',
    'design-policy' => get_template_directory() . '/iezukuri/templates/page-design-policy.php',
    'nasu-house'    => get_template_directory() . '/iezukuri/templates/page-nasu-house.php',
    'design-office' => get_template_directory() . '/iezukuri/templates/page-design-office.php',
    'company'       => get_template_directory() . '/iezukuri/templates/page-company.php',
    'contact'       => get_template_directory() . '/iezukuri/templates/page-contact.php',
);

$lookup_key = $template_key !== '' ? $template_key : $post_slug;
$partial_file = '';

if (isset($template_map[$lookup_key]) && file_exists($template_map[$lookup_key])) {
    $partial_file = $template_map[$lookup_key];
}

$layout_mode      = trim((string) get_post_meta($post_id, '_ch_layout_mode', true));
$use_parent_works = (string) get_post_meta($post_id, '_ch_use_parent_works', true) === '1';
$use_parent_flow  = (string) get_post_meta($post_id, '_ch_use_parent_flow', true) === '1';
$show_common_form = (string) get_post_meta($post_id, '_ch_show_common_form', true) === '1';
$show_common_faq  = (string) get_post_meta($post_id, '_ch_show_common_faq', true) === '1';
$common_form_shortcode = trim((string) get_post_meta($post_id, '_ch_common_form_shortcode', true));

$faq_items = array();
for ($i = 1; $i <= 5; $i++) {
    $q = trim((string) get_post_meta($post_id, '_ch_faq_' . $i . '_q', true));
    $a = trim((string) get_post_meta($post_id, '_ch_faq_' . $i . '_a', true));

    if ($q !== '' && $a !== '') {
        $faq_items[] = array(
            'q' => $q,
            'a' => $a,
        );
    }
}

if ($layout_mode === '') {
    $layout_mode = 'stack';
}

$layout_class = 'is-layout-' . sanitize_html_class($layout_mode);

$show_common_hero = true;

/* /iezukuri CSS is loaded by iezukuri/inc/assets/assets.php */

get_header('customhome');

/*
 * /iezukuri CSS is loaded by iezukuri/inc/assets/assets.php
 */

$main_classes = array(
    'hub-customhome-page',
    'hub-customhome-subpage',
    'hub-customhome-subpage--' . sanitize_html_class((string) $post_slug),
    'is-layout-stack',
);

if (!empty($template_key)) {
    $main_classes[] = 'hub-customhome-template--' . sanitize_html_class((string) $template_key);
}

if (!empty($layout_class) && (string) $layout_class !== 'is-layout-stack') {
    $main_classes[] = sanitize_html_class((string) $layout_class);
}

$main_classes = array_values(array_unique(array_filter($main_classes)));

echo '<main class="' . esc_attr(implode(' ', $main_classes)) . '" data-localnav-mode="hero_to_cta">';
?>



    <?php if ($show_common_hero) : ?>
        <section class="ch-hero ch-fullbleed ch-subpage-hero">
            <div class="ch-hero__media <?php echo count($hero_gallery_images) > 1 ? 'has-hero-gallery' : ''; ?>">
                <?php if ($hero_video_mp4) : ?>
                    <video class="ch-hero__video" autoplay muted loop playsinline preload="metadata" <?php echo $hero_image ? 'poster="' . esc_url($hero_image) . '"' : ''; ?>>
                        <source src="<?php echo esc_url($hero_video_mp4); ?>" type="video/mp4">
                    </video>
                <?php elseif (!empty($hero_gallery_images)) : ?>
                    <div class="ch-hero-gallery" data-ch-hero-gallery>
                        <?php foreach ($hero_gallery_images as $index => $gallery_image) : ?>
                            <img
                                class="ch-hero-gallery__item <?php echo $index === 0 ? 'is-active' : ''; ?>"
                                src="<?php echo esc_url($gallery_image['url']); ?>"
                                alt="<?php echo esc_attr($hero_title); ?>"
                                loading="<?php echo $index === 0 ? 'eager' : 'lazy'; ?>">
                        <?php endforeach; ?>
                    </div>
                <?php elseif ($hero_image) : ?>
                    <img class="ch-hero__image" src="<?php echo esc_url($hero_image); ?>" alt="<?php echo esc_attr($hero_title); ?>">
                <?php endif; ?>
                <div class="ch-hero__overlay"></div>
            </div>

            <?php if (!$hero_video_mp4 && count($hero_gallery_images) > 1) : ?>
                <script>
                document.addEventListener('DOMContentLoaded', function () {
                    document.querySelectorAll('[data-ch-hero-gallery]').forEach(function (gallery) {
                        const items = Array.from(gallery.querySelectorAll('.ch-hero-gallery__item'));
                        if (items.length < 2) return;

                        let index = 0;

                        window.setInterval(function () {
                            items[index].classList.remove('is-active');
                            index = (index + 1) % items.length;
                            items[index].classList.add('is-active');
                        }, 4200);
                    });
                });
                </script>
            <?php endif; ?>

            <div class="ch-shell ch-hero__inner">
                <div class="ch-hero__content">
                    <div class="ch-kicker"><?php echo esc_html($hero_kicker); ?></div>
                    <h1 class="ch-hero__title"><?php echo esc_html($hero_title); ?></h1>

                    <?php if ($lead !== '') : ?>
                        <p class="ch-hero__lead"><?php echo nl2br(esc_html($lead)); ?></p>
                    <?php endif; ?>

                    <div class="ch-hero__actions">
                        <a class="ch-btn ch-btn--primary" href="<?php echo esc_url($contact_url); ?>"><?php echo esc_html($hero_primary_label); ?></a>
                        <a class="ch-btn ch-btn--ghost" href="<?php echo esc_url($parent_url); ?>"><?php echo esc_html($hero_secondary_label); ?></a>
                    </div>
                </div>
            </div>
        </section>
    <?php endif; ?>

    <nav class="ch-localnav ch-localnav--construction" data-customhome-localnav aria-label="注文住宅固定ナビ">
        <div class="ch-shell">
            <?php if (has_nav_menu('customhome-page-menu')) : ?>
                <?php
                wp_nav_menu(array(
                    'theme_location' => 'customhome-page-menu',
                    'container'      => false,
                    'menu_class'     => 'ch-localnav__list',
                    'fallback_cb'    => false,
                ));
                ?>
            <?php else : ?>
                <ul class="ch-localnav__list">
                    <li><a href="<?php echo esc_url(home_url('/iezukuri/concept/')); ?>">注文住宅の考え方</a></li>
                    <li><a href="<?php echo esc_url(home_url('/iezukuri/design-policy/')); ?>">設計姿勢</a></li>
                    <li><a href="<?php echo esc_url(home_url('/iezukuri/nasu-house/')); ?>">那須での家づくり</a></li>
                    <li><a href="<?php echo esc_url(home_url('/iezukuri/design-office/')); ?>">デザインと設計</a></li>
                    <li><a href="<?php echo esc_url(home_url('/iezukuri/company/')); ?>">会社概要</a></li>
                    <li><a href="<?php echo esc_url(home_url('/iezukuri/contact/')); ?>">ご相談・資料請求</a></li>
                </ul>
            <?php endif; ?>
        </div>
    </nav>

    <?php if ($partial_file !== '') : ?>
        <?php require $partial_file; ?>
    <?php else : ?>
        <section class="ch-section ch-section--white ch-subpage-section">
            <div class="ch-shell">
                <article class="ch-subpage-main ch-subpage-main--fallback">
                    <?php
                    while (have_posts()) :
                        the_post();
                        the_content();
                    endwhile;
                    ?>
                </article>
            </div>
        </section>
    <?php endif; ?>

    <?php
    /* CUSTOMHOME BUILDER RENDER FINAL START
     * _ch_subpage_template が builder の場合だけ、
     * セクション構成ビルダーの順番で描画する。
     */
    $naigai_ch_current_layout_key = isset($lookup_key) ? (string) $lookup_key : '';
    if ($naigai_ch_current_layout_key === '') {
        $naigai_ch_current_layout_key = (string) get_post_meta($post_id, '_ch_subpage_template', true);
    }

    if ($naigai_ch_current_layout_key === 'builder' && function_exists('naigai_ch_render_builder_sections')) {
        naigai_ch_render_builder_sections($post_id);
    }
    /* CUSTOMHOME BUILDER RENDER FINAL END */
    ?>

    
<?php if ((isset($lookup_key) ? (string) $lookup_key : (string) get_post_meta($post_id, '_ch_subpage_template', true)) !== 'builder' && (string) get_post_meta($post_id, '_ch_show_customhome_cta', true) === '1') : ?>
        <?php
        $cta_variant = $lookup_key !== '' ? $lookup_key : $post_slug;
        $cta_shortcode = sprintf(
            '[customhome_cta variant="%s" inherit_text="0" inherit_media="0" inherit_settings="0"]',
            sanitize_key($cta_variant)
        );
        echo do_shortcode($cta_shortcode);
        ?>
    <?php endif; ?>

    <?php if ($show_common_form && $common_form_shortcode !== '') : ?>
        <section class="ch-section ch-section--white ch-subpage-form-section">
            <div class="ch-shell">
                <div class="ch-subpage-form-placeholder">
                    <?php echo do_shortcode($common_form_shortcode); ?>
                </div>
            </div>
        </section>
    <?php endif; ?>

    <?php if ($show_common_faq && !empty($faq_items)) : ?>
        <section class="ch-section ch-section--white ch-subpage-faq-section">
            <div class="ch-shell">
                <div class="ch-subpage-faq-placeholder">
                    <?php foreach ($faq_items as $index => $faq) : ?>
                        <details class="ch-faq-item" <?php echo $index === 0 ? ' open' : ''; ?>>
                            <summary><?php echo esc_html($faq['q']); ?></summary>
                            <div class="ch-faq-answer">
                                <p><?php echo nl2br(esc_html($faq['a'])); ?></p>
                            </div>
                        </details>
                    <?php endforeach; ?>
                </div>
            </div>
        </section>
    <?php endif; ?>
</main>
<?php get_footer('customhome'); ?>
