<?php
/*
Template Name: Construction Hub Sub Page
Template Post Type: page
*/

if (!defined('ABSPATH')) {
    exit;
}

/**
 * =========================================================
 * 基本情報
 * =========================================================
 */
$post_id       = get_the_ID();
$post_slug     = get_post_field('post_name', $post_id);
$template_key  = trim((string) get_post_meta($post_id, '_ch_subpage_template', true));
$title         = get_the_title($post_id);

/**
 * =========================================================
 * hero メタ
 * =========================================================
 */
$hero_kicker = trim((string) get_post_meta($post_id, '_ch_hero_kicker', true));
if ($hero_kicker === '') {
    $hero_kicker = 'CUSTOM HOME HUB';
}

$hero_title = trim((string) get_post_meta($post_id, '_ch_hero_title', true));
if ($hero_title === '') {
    $hero_title = $title;
}

$lead = trim((string) get_post_meta($post_id, '_ch_hero_lead', true));
if ($lead === '' && has_excerpt($post_id)) {
    $lead = get_the_excerpt($post_id);
}

$hero_image_id = (int) get_post_meta($post_id, '_ch_hero_image_id', true);
$hero_image    = $hero_image_id ? wp_get_attachment_image_url($hero_image_id, 'full') : get_the_post_thumbnail_url($post_id, 'full');

$parent_url = trim((string) get_post_meta($post_id, '_ch_back_url', true));
if ($parent_url === '') {
    $parent_url = home_url('/construction-hub/');
}

$contact_url = trim((string) get_post_meta($post_id, '_ch_contact_url', true));
if ($contact_url === '') {
    $contact_url = home_url('/construction-hub/contact/');
}

$hero_primary_label = trim((string) get_post_meta($post_id, '_ch_hero_primary_label', true));
if ($hero_primary_label === '') {
    $hero_primary_label = '無料相談・資料請求';
}

$hero_secondary_label = trim((string) get_post_meta($post_id, '_ch_hero_secondary_label', true));
if ($hero_secondary_label === '') {
    $hero_secondary_label = '注文住宅トップへ戻る';
}

/**
 * =========================================================
 * 共通CSS
 * =========================================================
 */
$base_css_rel = '/hub/css/hub-customhome.css';
$base_css_abs = get_template_directory() . $base_css_rel;

if (file_exists($base_css_abs)) {
    wp_enqueue_style(
        'hub-customhome',
        get_template_directory_uri() . $base_css_rel,
        array(),
        filemtime($base_css_abs)
    );
}

$sub_css_rel = '/hub/css/hub-customhome-subpage.css';
$sub_css_abs = get_template_directory() . $sub_css_rel;

if (file_exists($sub_css_abs)) {
    wp_enqueue_style(
        'hub-customhome-subpage',
        get_template_directory_uri() . $sub_css_rel,
        array('hub-customhome'),
        filemtime($sub_css_abs)
    );
}

if ($post_slug === 'nasu-house') {
    $nasu_css_rel = '/hub/css/customhome-pages/nasu-house.css';
    $nasu_css_abs = get_template_directory() . $nasu_css_rel;

    if (file_exists($nasu_css_abs)) {
        wp_enqueue_style(
            'hub-customhome-nasu-house',
            get_template_directory_uri() . $nasu_css_rel,
            array('hub-customhome', 'hub-customhome-subpage'),
            filemtime($nasu_css_abs)
        );
    }
}

/**
 * =========================================================
 * テンプレキーごとの追加CSS
 * 例:
 * _ch_subpage_template = nasu-house
 * → /hub/css/customhome-pages/nasu-house.css
 * =========================================================
 */
if ($template_key !== '') {
    $extra_css_rel = '/hub/css/customhome-pages/' . sanitize_file_name($template_key) . '.css';
    $extra_css_abs = get_template_directory() . $extra_css_rel;

    if (file_exists($extra_css_abs)) {
        wp_enqueue_style(
            'hub-customhome-template-' . sanitize_key($template_key),
            get_template_directory_uri() . $extra_css_rel,
            array('hub-customhome', 'hub-customhome-subpage'),
            filemtime($extra_css_abs)
        );
    }
}

/**
 * =========================================================
 * 本文テンプレート
 * メタキー優先
 * =========================================================
 */
$template_map = array(
    'concept'       => get_template_directory() . '/hub/templates/customhome-pages/page-concept.php',
    'design-policy' => get_template_directory() . '/hub/templates/customhome-pages/page-design-policy.php',
    'nasu-house'    => get_template_directory() . '/hub/templates/customhome-pages/page-nasu-house.php',
    'design-office' => get_template_directory() . '/hub/templates/customhome-pages/page-design-office.php',
    'company'       => get_template_directory() . '/hub/templates/customhome-pages/page-company.php',
    'contact'       => get_template_directory() . '/hub/templates/customhome-pages/page-contact.php',
);

$lookup_key = $template_key !== '' ? $template_key : $post_slug;
$partial_file = '';

if (isset($template_map[$lookup_key]) && file_exists($template_map[$lookup_key])) {
    $partial_file = $template_map[$lookup_key];
}

$show_common_hero = ($lookup_key !== 'concept');

get_header('customhome');
?>
<main class="hub-customhome-page hub-customhome-subpage hub-customhome-subpage--<?php echo esc_attr($post_slug); ?> <?php echo $template_key !== '' ? 'hub-customhome-template--' . esc_attr($template_key) : ''; ?>" data-localnav-mode="hero_to_cta">

    <?php if ($show_common_hero) : ?>
    <section class="ch-hero ch-fullbleed ch-subpage-hero">
        <div class="ch-hero__media">
            <?php if ($hero_image) : ?>
                <img class="ch-hero__image" src="<?php echo esc_url($hero_image); ?>" alt="<?php echo esc_attr($hero_title); ?>">
            <?php endif; ?>
            <div class="ch-hero__overlay"></div>
        </div>

        <div class="ch-shell ch-hero__inner">
            <div class="ch-hero__content">
                <div class="ch-kicker"><?php echo esc_html($hero_kicker); ?></div>
                <h1 class="ch-hero__title"><?php echo esc_html($hero_title); ?></h1>

                <?php if ($lead !== '') : ?>
                    <p class="ch-hero__lead"><?php echo nl2br(esc_html($lead)); ?></p>
                <?php endif; ?>

                <div class="ch-hero__actions">
                    <a class="ch-btn ch-btn--primary" href="<?php echo esc_url($contact_url); ?>"><?php echo esc_html($hero_primary_label); ?></a>
                    <a class="ch-btn ch-btn--ghost" href="<?php echo esc_url($parent_url); ?>"><?php echo esc_html($hero_secondary_label); ?></a>
                </div>
            </div>
        </div>
    </section>
    <?php endif; ?>

    <nav class="ch-localnav ch-localnav--construction" data-customhome-localnav aria-label="注文住宅固定ナビ">
        <div class="ch-shell">
            <?php if (has_nav_menu('customhome-page-menu')) : ?>
                <?php
                wp_nav_menu(array(
                    'theme_location' => 'customhome-page-menu',
                    'container'      => false,
                    'menu_class'     => 'ch-localnav__list',
                    'fallback_cb'    => false,
                ));
                ?>
            <?php else : ?>
                <ul class="ch-localnav__list">
                    <li><a href="<?php echo esc_url(home_url('/construction-hub/concept/')); ?>">注文住宅の考え方</a></li>
                    <li><a href="<?php echo esc_url(home_url('/construction-hub/design-policy/')); ?>">設計姿勢</a></li>
                    <li><a href="<?php echo esc_url(home_url('/construction-hub/nasu-house/')); ?>">那須での家づくり</a></li>
                    <li><a href="<?php echo esc_url(home_url('/construction-hub/design-office/')); ?>">デザインと設計</a></li>
                    <li><a href="<?php echo esc_url(home_url('/construction-hub/company/')); ?>">会社概要</a></li>
                    <li><a href="<?php echo esc_url(home_url('/construction-hub/contact/')); ?>">ご相談・資料請求</a></li>
                </ul>
            <?php endif; ?>
        </div>
    </nav>

    <section class="ch-section ch-section--white ch-subpage-section">
        <div class="ch-shell">
            <?php if ($partial_file !== '') : ?>
                <?php require $partial_file; ?>
            <?php else : ?>
                <article class="ch-subpage-main ch-subpage-main--fallback">
                    <?php
                    while (have_posts()) :
                        the_post();
                        the_content();
                    endwhile;
                    ?>
                </article>
            <?php endif; ?>
        </div>
    </section>
</main>
<?php get_footer('customhome'); ?>
