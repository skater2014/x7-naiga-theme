<?php
/**
 * /iezukuri トップLP
 * 選択テーマ別ストーリーカード。
 *
 * 旧テーブル表は停止中。
 * 旧ファイルは .bak に残す。
 *
 * 目的:
 * - ユーザーが自分の家族・暮らしに当てはめて考えられる構成にする
 * - Before / Action
 * - 間取りの考え方
 * - ＋カード
 */

if (!defined('ABSPATH')) {
    exit;
}

$story_file = __DIR__ . '/section-feature-story-card-data.php';

if (!file_exists($story_file)) {
    return;
}

$story_data = require $story_file;

if (!is_array($story_data)) {
    return;
}

$term = '';

if (isset($item) && is_array($item) && !empty($item['term'])) {
    $term = (string) $item['term'];
}

if ($term === '' || empty($story_data[$term])) {
    return;
}

$story = $story_data[$term];
?>

<section class="ch-story-block" data-ch-story-block aria-label="<?php echo esc_attr($story['heading'] ?? ''); ?>">
    <div class="ch-story-block__head">
        <?php if (!empty($story['label'])) : ?>
            <p class="ch-story-block__label"><?php echo esc_html($story['label']); ?></p>
        <?php endif; ?>

        <?php if (!empty($story['title'])) : ?>
            <h4 class="ch-story-block__title"><?php echo esc_html($story['title']); ?></h4>
        <?php endif; ?>

        <?php if (!empty($story['lead'])) : ?>
            <p class="ch-story-block__lead"><?php echo esc_html($story['lead']); ?></p>
        <?php endif; ?>
    </div>

    <?php if (!empty($story['story'])) : ?>
        <div class="ch-story-narrative">
            <p><?php echo esc_html($story['story']); ?></p>
        </div>
    <?php endif; ?>

    <div class="ch-story-ba">
        <article class="ch-story-ba-card is-before">
            <?php if (!empty($story['before_image'])) : ?>
                <figure class="ch-story-ba-card__image">
                    <img src="<?php echo esc_url($story['before_image']); ?>" alt="Before：今の悩み">
                </figure>
            <?php endif; ?>

            <p class="ch-story-ba-card__label">Before</p>
            <h5 class="ch-story-ba-card__title">今の悩み</h5>

            <?php if (!empty($story['before']) && is_array($story['before'])) : ?>
                <ul>
                    <?php foreach ($story['before'] as $text) : ?>
                        <li><?php echo esc_html($text); ?></li>
                    <?php endforeach; ?>
                </ul>
            <?php endif; ?>
        </article>

        <article class="ch-story-ba-card is-action">
            <?php if (!empty($story['action_image'])) : ?>
                <figure class="ch-story-ba-card__image">
                    <img src="<?php echo esc_url($story['action_image']); ?>" alt="Action：計画・改善すること">
                </figure>
            <?php endif; ?>

            <p class="ch-story-ba-card__label">Action</p>
            <h5 class="ch-story-ba-card__title">計画・改善すること</h5>

            <?php if (!empty($story['action']) && is_array($story['action'])) : ?>
                <ul>
                    <?php foreach ($story['action'] as $text) : ?>
                        <li><?php echo esc_html($text); ?></li>
                    <?php endforeach; ?>
                </ul>
            <?php endif; ?>
        </article>
    </div>

    <?php if (!empty($story['layouts']) && is_array($story['layouts'])) : ?>
        <div class="ch-story-layout">
            <div class="ch-story-layout__head">
                <p class="ch-story-block__label">Layout Idea</p>
                <h5>間取りの考え方</h5>
            </div>

            <div class="ch-story-layout__grid">
                <?php foreach ($story['layouts'] as $layout) : ?>
                    <article class="ch-story-layout-card">
                        <p class="ch-story-layout-card__point"><?php echo esc_html($layout['point'] ?? ''); ?></p>
                        <h6><?php echo esc_html($layout['title'] ?? ''); ?></h6>
                        <p><?php echo esc_html($layout['text'] ?? ''); ?></p>
                    </article>
                <?php endforeach; ?>
            </div>
        </div>
    <?php endif; ?>

    <?php if (!empty($story['more']) && is_array($story['more'])) : ?>
        <div class="ch-story-more" data-ch-story-more>
            <button class="ch-story-more__toggle" type="button" data-ch-story-more-toggle>
                ほかの考え方を見る ＋
            </button>

            <div class="ch-story-more__grid" data-ch-story-more-body hidden>
                <?php foreach ($story['more'] as $more) : ?>
                    <article class="ch-story-more-card">
                        <h6><?php echo esc_html($more['title'] ?? ''); ?></h6>
                        <p><?php echo esc_html($more['text'] ?? ''); ?></p>
                    </article>
                <?php endforeach; ?>
            </div>
        </div>
    <?php endif; ?>

    <?php
    /*
     * 旧テーブル表は停止中。
     * Before / Action / 間取り案カードへ置き換え。
     */
    ?>
</section>
