/* === stack plan panels START === */
.hub-customhome-page.hub-customhome-top .ch-top-services.has-plan-stack .ch-service-route-grid {
  display: none !important;
}

.hub-customhome-page.hub-customhome-top .ch-service-stack {
  display: grid;
  gap: clamp(28px, 5vw, 56px);
  margin-top: 24px;
}

.hub-customhome-page.hub-customhome-top .ch-service-stack .ch-service-panel {
  display: block !important;
}

.hub-customhome-page.hub-customhome-top .ch-service-next {
  display: block;
  margin-top: clamp(28px, 4vw, 48px);
}

.hub-customhome-page.hub-customhome-top .ch-service-next__head {
  margin-bottom: 16px;
  text-align: center;
}

.hub-customhome-page.hub-customhome-top .ch-service-next__head h3 {
  margin: 6px 0 0;
  color: var(--iezukuri-text);
  font-size: clamp(22px, 2.5vw, 32px);
}

.hub-customhome-page.hub-customhome-top .ch-service-next-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: clamp(14px, 2vw, 22px);
}

.hub-customhome-page.hub-customhome-top .ch-service-next-card {
  overflow: hidden;
  border: 1px solid var(--iezukuri-border);
  border-radius: 20px;
  background: var(--iezukuri-surface);
}

.hub-customhome-page.hub-customhome-top .ch-service-next-card__select {
  display: grid;
  grid-template-columns: auto 150px minmax(0, 1fr);
  gap: 14px;
  align-items: stretch;
  min-height: 150px;
  padding: 14px;
  cursor: pointer;
}

.hub-customhome-page.hub-customhome-top .ch-service-next-card__num {
  color: var(--iezukuri-accent);
  font-size: 28px;
  font-weight: 900;
}

.hub-customhome-page.hub-customhome-top .ch-service-next-card__image {
  display: block;
  overflow: hidden;
  border-radius: 14px;
  background: var(--iezukuri-bg);
}

.hub-customhome-page.hub-customhome-top .ch-service-next-card__image img {
  width: 100%;
  height: 100%;
  min-height: 122px;
  object-fit: cover;
}

.hub-customhome-page.hub-customhome-top .ch-service-next-card__body {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hub-customhome-page.hub-customhome-top .ch-service-next-card__body strong {
  color: var(--iezukuri-text);
  font-size: 18px;
  line-height: 1.45;
}

.hub-customhome-page.hub-customhome-top .ch-service-next-card__body em {
  margin-top: 4px;
  color: var(--iezukuri-accent);
  font-style: normal;
  font-weight: 900;
}

.hub-customhome-page.hub-customhome-top .ch-service-next-card__body small {
  margin-top: 8px;
  color: var(--iezukuri-muted);
  font-size: 13px;
  line-height: 1.6;
}

@media (max-width: 800px) {
  .hub-customhome-page.hub-customhome-top .ch-service-next-grid {
    grid-template-columns: 1fr;
  }

  .hub-customhome-page.hub-customhome-top .ch-service-next-card__select {
    grid-template-columns: auto 110px minmax(0, 1fr);
  }
}
/* === stack plan panels END === */

/* === stack default/mobile fix START === */

/* radio復元や旧CSSで最初からチェック表示されるのを防ぐ */
.hub-customhome-page.hub-customhome-top .ch-service-route-card__check {
  color: transparent !important;
}

/* 元のパネル置き場はJSのテンプレート用。表示はstackだけにする */
.hub-customhome-page.hub-customhome-top .ch-service-panels {
  display: none !important;
}

.hub-customhome-page.hub-customhome-top .ch-service-stack .ch-service-panel {
  display: block !important;
}

/* 初期カードは、選択後だけ消す */
.hub-customhome-page.hub-customhome-top .ch-top-services.has-plan-stack .ch-service-route-grid {
  display: none !important;
}

/* 残りカードの番号・見出しズレ対策 */
.hub-customhome-page.hub-customhome-top .ch-service-next-card__num {
  flex: 0 0 auto;
  line-height: 1;
}

/* mobile */
@media (max-width: 680px) {
  .hub-customhome-page.hub-customhome-top .ch-service-route-grid,
  .hub-customhome-page.hub-customhome-top .ch-service-next-grid {
    grid-template-columns: 1fr !important;
  }

  .hub-customhome-page.hub-customhome-top .ch-service-route-card__select {
    grid-template-columns: 96px minmax(0, 1fr);
    min-height: 132px;
  }

  .hub-customhome-page.hub-customhome-top .ch-service-route-card__image,
  .hub-customhome-page.hub-customhome-top .ch-service-route-card__image img {
    height: 132px;
    min-height: 132px;
  }

  .hub-customhome-page.hub-customhome-top .ch-service-next-card__select {
    grid-template-columns: 52px 96px minmax(0, 1fr);
    gap: 10px;
    min-height: 124px;
    padding: 12px;
  }

  .hub-customhome-page.hub-customhome-top .ch-service-next-card__num {
    font-size: 24px;
  }

  .hub-customhome-page.hub-customhome-top .ch-service-next-card__image img {
    min-height: 96px;
  }

  .hub-customhome-page.hub-customhome-top .ch-service-panel__head {
    grid-template-columns: 1fr;
  }

  .hub-customhome-page.hub-customhome-top .ch-service-panel__actions {
    justify-content: flex-start;
  }
}
/* === stack default/mobile fix END === */

/* === stack number/mobile tune START === */

/* 初期3カードでは 01/02/03 を出さない。番号は押した後のパネルから始める。 */
.hub-customhome-page.hub-customhome-top .ch-service-route-grid > .ch-service-route-card .ch-service-route-card__num {
  display: none !important;
}

/* 残りカードは「次は 02」のように表示する */
.hub-customhome-page.hub-customhome-top .ch-service-next-card__num {
  min-width: 74px;
  white-space: nowrap;
  font-size: 15px;
  line-height: 1.2;
}

/* 初期カードのチェックがブラウザ復元で見える場合を潰す */
