/* =========================================================
 * hub/pages/iezukuri/css/top/service-panel.css
 *
 * 対象:
 * - /iezukuri/ トップ「3つの住まい」
 *
 * 役割:
 * - 3カード
 * - radioチェック
 * - 選択パネル
 * - 外観 / 間取り図 / 内装 の横並び
 * ========================================================= */

.hub-customhome-page.hub-customhome-top .ch-top-services {
  background: var(--iezukuri-bg);
}

.hub-customhome-page.hub-customhome-top .ch-top-services .ch-head {
  max-width: 880px;
  margin: 0 auto 22px;
  text-align: center;
}

.hub-customhome-page.hub-customhome-top .ch-service-panel-radio {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.hub-customhome-page.hub-customhome-top .ch-service-route-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(12px, 1.6vw, 20px);
  margin-top: 24px;
}

.hub-customhome-page.hub-customhome-top .ch-service-route-card {
  min-width: 0;
  overflow: hidden;
  border: 1px solid var(--iezukuri-border);
  border-radius: 20px;
  background: var(--iezukuri-surface);
  box-shadow: var(--iezukuri-shadow, 0 16px 36px rgba(24, 18, 14, .06));
}

.hub-customhome-page.hub-customhome-top .ch-service-route-card__select {
  position: relative;
  display: grid;
  grid-template-columns: 150px minmax(0, 1fr);
  min-height: 168px;
  color: var(--iezukuri-text);
  cursor: pointer;
}

.hub-customhome-page.hub-customhome-top .ch-service-route-card__check {
  position: absolute;
  z-index: 5;
  top: 12px;
  left: 12px;
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  border: 1px solid rgba(81, 70, 51, .32);
  border-radius: 999px;
  background: rgba(255,255,255,.92);
  color: transparent;
  font-size: 13px;
  font-weight: 900;
}

.hub-customhome-page.hub-customhome-top #ch-service-panel-0:checked ~ .ch-service-route-grid label[for="ch-service-panel-0"],
.hub-customhome-page.hub-customhome-top #ch-service-panel-1:checked ~ .ch-service-route-grid label[for="ch-service-panel-1"],
.hub-customhome-page.hub-customhome-top #ch-service-panel-2:checked ~ .ch-service-route-grid label[for="ch-service-panel-2"] {
  outline: 2px solid rgba(168,133,63,.55);
  outline-offset: 3px;
}

.hub-customhome-page.hub-customhome-top #ch-service-panel-0:checked ~ .ch-service-route-grid label[for="ch-service-panel-0"] .ch-service-route-card__check,
.hub-customhome-page.hub-customhome-top #ch-service-panel-1:checked ~ .ch-service-route-grid label[for="ch-service-panel-1"] .ch-service-route-card__check,
.hub-customhome-page.hub-customhome-top #ch-service-panel-2:checked ~ .ch-service-route-grid label[for="ch-service-panel-2"] .ch-service-route-card__check {
  background: var(--iezukuri-accent);
  border-color: var(--iezukuri-accent);
  color: var(--iezukuri-surface);
}

.hub-customhome-page.hub-customhome-top .ch-service-route-card__image {
  display: grid;
  place-items: center;
  min-height: 168px;
  overflow: hidden;
  background: var(--iezukuri-bg-warm);
}

.hub-customhome-page.hub-customhome-top .ch-service-route-card__image img {
  display: block;
  width: 100%;
  height: 168px;
  object-fit: cover;
}

.hub-customhome-page.hub-customhome-top .ch-service-route-card__image span {
  display: grid;
  place-items: center;
  width: 58px;
  height: 58px;
  border-radius: 999px;
  background: var(--iezukuri-surface);
  color: var(--iezukuri-accent);
  font-weight: 900;
}

.hub-customhome-page.hub-customhome-top .ch-service-route-card__body {
  display: flex;
  flex-direction: column;
  padding: 18px;
}

.hub-customhome-page.hub-customhome-top .ch-service-route-card__num {
  margin-bottom: 8px;
  color: var(--iezukuri-accent);
  font-size: 12px;
  font-weight: 900;
  letter-spacing: .12em;
}

.hub-customhome-page.hub-customhome-top .ch-service-route-card h3 {
  margin: 0;
  color: var(--iezukuri-text);
  font-size: 18px;
  line-height: 1.4;
}

.hub-customhome-page.hub-customhome-top .ch-service-route-card p {
  margin: 10px 0 0;
  color: var(--iezukuri-muted);
  font-size: 13px;
  line-height: 1.65;
}

.hub-customhome-page.hub-customhome-top .ch-service-route-card b {
  margin-top: auto;
  padding-top: 12px;
  color: var(--iezukuri-accent);
  font-size: 13px;
  font-weight: 900;
}

.hub-customhome-page.hub-customhome-top .ch-service-route-card b::after {
  content: "→";
  margin-left: .45em;
}

.hub-customhome-page.hub-customhome-top .ch-service-panels {
  margin-top: 18px;
}

.hub-customhome-page.hub-customhome-top .ch-service-panel {
  display: none;
  padding: clamp(20px, 3vw, 32px);
  border: 1px solid var(--iezukuri-border);
  border-radius: 24px;
  background: var(--iezukuri-surface);
  box-shadow: var(--iezukuri-shadow, 0 16px 36px rgba(24, 18, 14, .06));
}

.hub-customhome-page.hub-customhome-top #ch-service-panel-0:checked ~ .ch-service-panels .ch-service-panel--0,
.hub-customhome-page.hub-customhome-top #ch-service-panel-1:checked ~ .ch-service-panels .ch-service-panel--1,
.hub-customhome-page.hub-customhome-top #ch-service-panel-2:checked ~ .ch-service-panels .ch-service-panel--2 {
  display: block;
}

.hub-customhome-page.hub-customhome-top .ch-service-panel__head {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  gap: 18px;
  align-items: center;
  margin-bottom: 22px;
}

.hub-customhome-page.hub-customhome-top .ch-service-panel__num {
  color: var(--iezukuri-accent);
  font-size: clamp(34px, 5vw, 56px);
  font-weight: 900;
  letter-spacing: .08em;
}

.hub-customhome-page.hub-customhome-top .ch-service-panel__label {
  margin: 0 0 6px;
  color: var(--iezukuri-accent);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.hub-customhome-page.hub-customhome-top .ch-service-panel__head h3 {
  margin: 0;
  color: var(--iezukuri-text);
  font-size: clamp(25px, 3vw, 36px);
  line-height: 1.35;
}

.hub-customhome-page.hub-customhome-top .ch-service-panel__head p {
  margin: 8px 0 0;
  color: var(--iezukuri-muted);
  line-height: 1.75;
}

.hub-customhome-page.hub-customhome-top .ch-service-panel__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: flex-end;
}

.hub-customhome-page.hub-customhome-top .ch-service-panel__link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 0 18px;
  border-radius: 999px;
  background: var(--iezukuri-accent-strong);
  color: var(--iezukuri-surface);
  text-decoration: none;
  font-size: 14px;
  font-weight: 900;
  white-space: nowrap;
}

.hub-customhome-page.hub-customhome-top .ch-service-panel__link.is-secondary {
  background: transparent;
  border: 1px solid var(--iezukuri-border);
  color: var(--iezukuri-text);
}

.hub-customhome-page.hub-customhome-top .ch-service-panel__media {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(12px, 1.8vw, 20px);
  align-items: stretch;
}

.hub-customhome-page.hub-customhome-top .ch-service-panel-media {
  display: grid;
  grid-template-rows: auto minmax(190px, auto) auto;
  gap: 10px;
  min-width: 0;
}

.hub-customhome-page.hub-customhome-top .ch-service-panel-media__title {
  color: var(--iezukuri-accent);
  font-size: 13px;
  font-weight: 900;
  letter-spacing: .14em;
  text-align: center;
}

.hub-customhome-page.hub-customhome-top .ch-service-panel-media__image {
  display: grid;
  place-items: center;
  min-height: 190px;
  overflow: hidden;
  border-radius: 16px;
  background: var(--iezukuri-bg-warm);
}

.hub-customhome-page.hub-customhome-top .ch-service-panel-media__image img {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 190px;
  object-fit: cover;
}

.hub-customhome-page.hub-customhome-top .ch-service-panel-media__image span {
  display: grid;
  place-items: center;
  min-height: 190px;
  color: rgba(81,70,51,.42);
  font-weight: 900;
}

.hub-customhome-page.hub-customhome-top .ch-service-panel-media__floor {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.hub-customhome-page.hub-customhome-top .ch-service-panel-media p {
  margin: 0;
  color: var(--iezukuri-muted);
  font-size: 13px;
  line-height: 1.65;
}

@media (max-width: 1100px) {
  .hub-customhome-page.hub-customhome-top .ch-service-route-grid {
    grid-template-columns: 1fr;
  }

  .hub-customhome-page.hub-customhome-top .ch-service-panel__head {
    grid-template-columns: 1fr;
  }

  .hub-customhome-page.hub-customhome-top .ch-service-panel__actions {
    justify-content: flex-start;
  }

  .hub-customhome-page.hub-customhome-top .ch-service-panel__media {
    grid-template-columns: repeat(3, minmax(230px, 1fr));
    overflow-x: auto;
    padding-bottom: 8px;
    -webkit-overflow-scrolling: touch;
  }
}

@media (max-width: 600px) {
  .hub-customhome-page.hub-customhome-top .ch-service-route-card__select {
    grid-template-columns: 112px minmax(0, 1fr);
    min-height: 138px;
  }

  .hub-customhome-page.hub-customhome-top .ch-service-route-card__image,
  .hub-customhome-page.hub-customhome-top .ch-service-route-card__image img {
    height: 138px;
    min-height: 138px;
  }

  .hub-customhome-page.hub-customhome-top .ch-service-route-card__body {
    padding: 14px;
  }

  .hub-customhome-page.hub-customhome-top .ch-service-panel {
    padding: 18px;
  }

  .hub-customhome-page.hub-customhome-top .ch-service-panel__media {
    grid-template-columns: repeat(3, minmax(220px, 1fr));
  }

  .hub-customhome-page.hub-customhome-top .ch-service-panel-media__floor {
    grid-template-columns: repeat(2, minmax(104px, 1fr));
  }
}

/* === story / detail / compare add START === */
.hub-customhome-page.hub-customhome-top .ch-service-story {
  margin-top: 26px;
  padding: clamp(20px, 3vw, 30px);
  border-radius: 22px;
  background: var(--iezukuri-bg);
}

.hub-customhome-page.hub-customhome-top .ch-service-story h3 {
  margin: 8px 0 0;
  color: var(--iezukuri-text);
  font-size: clamp(24px, 3vw, 36px);
  line-height: 1.35;
}

.hub-customhome-page.hub-customhome-top .ch-service-story p:not(.ch-eyebrow) {
  margin: 14px 0 0;
  color: var(--iezukuri-muted);
  line-height: 1.9;
}

.hub-customhome-page.hub-customhome-top .ch-service-detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-top: 18px;
}

.hub-customhome-page.hub-customhome-top .ch-service-detail-grid section {
  padding: 20px;
  border: 1px solid var(--iezukuri-border);
  border-radius: 20px;
  background: var(--iezukuri-surface);
}

.hub-customhome-page.hub-customhome-top .ch-service-detail-grid h4 {
  margin: 0 0 12px;
  color: var(--iezukuri-text);
}

.hub-customhome-page.hub-customhome-top .ch-service-detail-grid ul {
  display: grid;
  gap: 8px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.hub-customhome-page.hub-customhome-top .ch-service-detail-grid li {
  color: var(--iezukuri-muted);
  line-height: 1.7;
}

.hub-customhome-page.hub-customhome-top .ch-service-compare {
  margin-top: clamp(36px, 5vw, 64px);
}

.hub-customhome-page.hub-customhome-top .ch-compare-table-wrap {
  overflow-x: auto;
  border: 1px solid var(--iezukuri-border);
  border-radius: 22px;
  background: var(--iezukuri-surface);
}

.hub-customhome-page.hub-customhome-top .ch-compare-table {
  width: 100%;
  min-width: 900px;
  border-collapse: collapse;
}

.hub-customhome-page.hub-customhome-top .ch-compare-table th,
.hub-customhome-page.hub-customhome-top .ch-compare-table td {
  padding: 16px;
  border-bottom: 1px solid var(--iezukuri-border);
  border-right: 1px solid var(--iezukuri-border);
  color: var(--iezukuri-text);
  line-height: 1.7;
  text-align: left;
  vertical-align: top;
}

.hub-customhome-page.hub-customhome-top .ch-compare-table thead th {
  background: var(--iezukuri-bg);
  font-weight: 900;
}

@media (max-width: 800px) {
  .hub-customhome-page.hub-customhome-top .ch-service-detail-grid {
    grid-template-columns: 1fr;
  }
}
/* === story / detail / compare add END === */

