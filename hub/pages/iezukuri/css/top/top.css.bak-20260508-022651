/* =========================================================
 * hub/pages/iezukuri/css/top/top.css
 *
 * 注文住宅トップ / construction-hub 専用CSS
 *
 * 方針:
 * - このファイルでトップページの見た目を一元管理
 * - CTA CSSは「09. CTA / split layout」だけ
 * - 末尾追記で逃げない
 * - サブページ固有レイアウトは入れない
 * ========================================================= */

@import url("./service-panel.css");
@import url("./top-footer.css");

/* =========================================================
 * 01. Base
 * ========================================================= */

.hub-customhome-page {
  background: var(--iezukuri-bg);
  color: var(--iezukuri-text-strong);
  overflow-x: hidden;
}

.hub-customhome-page *,
.hub-customhome-page *::before,
.hub-customhome-page *::after {
  box-sizing: border-box;
}

.hub-customhome-page .ch-shell {
  width: calc(100% - 80px);
  max-width: 1280px;
  margin: 0 auto;
}

.hub-customhome-page .ch-fullbleed {
  width: 100vw;
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
}

/* =========================================================
 * 02. Header
 * ========================================================= */

.ch-site-header {
  position: sticky;
  top: 0;
  z-index: 80;
  border-bottom: 1px solid rgba(77, 53, 29, 0.1);
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(10px);
}

.ch-site-header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  width: calc(100% - 40px);
  max-width: 1280px;
  min-height: 72px;
  margin: 0 auto;
}

.ch-site-header__brand {
  display: inline-flex;
  align-items: center;
  min-height: 48px;
  color: var(--iezukuri-text);
  text-decoration: none;
}

.ch-site-header__brand-logo {
  display: block;
  max-width: 180px;
  max-height: 42px;
  width: auto;
  height: auto;
}

.ch-site-header__brand-main {
  font-size: 22px;
  font-weight: 800;
  line-height: 1.2;
}

.ch-site-header__brand-sub {
  margin-left: 10px;
  color: #9b6a31;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.14em;
}

.ch-site-header__nav--desktop {
  margin-left: auto;
}

.ch-site-header__list,
.ch-site-header__drawer-list {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.ch-site-header__list li,
.ch-site-header__drawer-list li {
  margin: 0;
  padding: 0;
  list-style: none;
}

.ch-site-header__list a,
.ch-site-header__drawer-list a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  padding: 0 16px;
  border-radius: 999px;
  color: var(--iezukuri-text);
  text-decoration: none;
  font-size: 14px;
  font-weight: 700;
  white-space: nowrap;
}

.ch-site-header__list a:hover,
.ch-site-header__drawer-list a:hover {
  background: #f5ecdf;
}

.ch-site-header--pipe .ch-site-header__list {
  gap: 0;
}

.ch-site-header--pipe .ch-site-header__list li + li::before {
  content: '|';
  margin: 0 10px;
  color: #8b7e71;
}

.ch-site-header--pipe .ch-site-header__list a,
.ch-site-header--minimal .ch-site-header__list a {
  min-height: auto;
  border-radius: 0;
}

.ch-site-header--pipe .ch-site-header__list a {
  padding: 0;
}

.ch-site-header--minimal .ch-site-header__list a {
  padding: 0 8px;
}

.ch-site-header--pipe .ch-site-header__list a:hover,
.ch-site-header--minimal .ch-site-header__list a:hover {
  background: transparent;
  color: #9b6a31;
}

.ch-site-header__toggle {
  display: none;
  width: 44px;
  height: 44px;
  padding: 0;
  border: 1px solid rgba(77, 53, 29, 0.16);
  border-radius: 999px;
  background: var(--iezukuri-surface);
  cursor: pointer;
}

.ch-site-header__toggle span {
  display: block;
  width: 18px;
  height: 2px;
  margin: 4px auto;
  background: var(--iezukuri-text);
}

.ch-site-header__drawer[hidden] {
  display: none !important;
}

.ch-site-header__drawer {
  position: fixed;
  inset: 72px 0 0 0;
  z-index: 79;
  background: rgba(10, 10, 10, 0.34);
}

.ch-site-header__drawer-inner {
  padding: 18px;
  background: var(--iezukuri-surface);
  border-top: 1px solid rgba(77, 53, 29, 0.1);
}

.ch-site-header__drawer-list {
  flex-direction: column;
  align-items: stretch;
}

.ch-site-header__drawer-list a {
  justify-content: flex-start;
  min-height: 46px;
  padding: 0 8px;
  border-bottom: 1px solid #f1f1f1;
}

/* =========================================================
 * 03. Hero
 * ========================================================= */

.hub-customhome-page .ch-hero {
  position: relative;
  min-height: 820px;
  background: #111;
  overflow: hidden;
}

.hub-customhome-page .ch-hero__media,
.hub-customhome-page .ch-hero__video,
.hub-customhome-page .ch-hero__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hub-customhome-page .ch-hero__video,
.hub-customhome-page .ch-hero__image {
  display: block;
  object-fit: cover;
}

.hub-customhome-page .ch-hero__overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(10, 10, 10, 0.58) 0%, rgba(10, 10, 10, 0.46) 38%, rgba(10, 10, 10, 0.18) 100%),
    linear-gradient(180deg, rgba(10, 10, 10, 0.18) 0%, rgba(10, 10, 10, 0.34) 100%);
}

.hub-customhome-page .ch-hero__inner {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  min-height: 820px;
}

.hub-customhome-page .ch-hero__content {
  width: 760px;
  max-width: 100%;
  padding: 110px 0 90px;
  color: var(--iezukuri-surface);
}

.hub-customhome-page .ch-hero__brand-logo-wrap {
  margin: 0 0 14px;
}

.hub-customhome-page .ch-hero__brand-logo {
  display: block;
  max-width: 220px;
  width: auto;
  height: auto;
}

.hub-customhome-page .ch-hero__company {
  margin: 0 0 10px;
  color: rgba(255, 255, 255, 0.88);
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.hub-customhome-page .ch-hero__company-sub {
  margin: 0 0 14px;
  color: rgba(255, 255, 255, 0.74);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.hub-customhome-page .ch-kicker {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  padding: 0 18px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.14);
  border: 1px solid rgba(255, 255, 255, 0.14);
  color: var(--iezukuri-surface);
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 0.06em;
}

.hub-customhome-page .ch-hero__title {
  margin: 24px 0 0;
  color: var(--iezukuri-surface);
  font-size: 76px;
  line-height: 1.05;
  letter-spacing: -0.04em;
}

.hub-customhome-page .ch-hero__lead {
  width: 560px;
  max-width: 100%;
  margin: 26px 0 0;
  color: rgba(255, 255, 255, 0.88);
  font-size: 19px;
  line-height: 1.9;
}

.hub-customhome-page .ch-hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 34px;
}

/* =========================================================
 * 04. Buttons
 * ========================================================= */

.hub-customhome-page .ch-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 54px;
  padding: 0 26px;
  border-radius: 999px;
  text-decoration: none;
  font-size: 15px;
  font-weight: 700;
  transition: transform 0.2s ease, opacity 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
}

.hub-customhome-page .ch-btn:hover {
  opacity: 0.94;
  transform: translateY(-1px);
}

.hub-customhome-page .ch-btn--primary {
  background: #b78242;
  border: 1px solid #b78242;
  color: var(--iezukuri-surface);
}

.hub-customhome-page .ch-btn--ghost {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.34);
  color: var(--iezukuri-surface);
}

.hub-customhome-page .ch-btn--ghost-light {
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.52);
  color: var(--iezukuri-surface);
}

/* =========================================================
 * 05. Local nav
 * ========================================================= */

.hub-customhome-page .ch-localnav {
  position: sticky;
  top: 72px;
  z-index: 70;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(77, 53, 29, 0.1);
}

.hub-customhome-page .ch-localnav__list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 0;
  padding: 12px 0;
  list-style: none;
}

.hub-customhome-page .ch-localnav__list li {
  margin: 0;
  padding: 0;
  list-style: none;
}

.hub-customhome-page .ch-localnav__list a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40px;
  padding: 0 16px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.96);
  border: 1px solid rgba(77, 53, 29, 0.12);
  color: var(--iezukuri-text);
  text-decoration: none;
  font-size: 14px;
  font-weight: 700;
  white-space: nowrap;
}

.hub-customhome-page .ch-localnav__list a:hover {
  background: #f5ecdf;
}

.hub-customhome-page .ch-localnav__list a.is-active,
.hub-customhome-page .ch-localnav__list .current-menu-item > a,
.hub-customhome-page .ch-localnav__list .current_page_item > a {
  background: #1d2327;
  border-color: #1d2327;
  color: var(--iezukuri-surface);
}

.hub-customhome-page .ch-localnav--underline .ch-localnav__list a {
  min-height: auto;
  padding: 12px 4px;
  border: 0;
  border-radius: 0;
  background: transparent;
  border-bottom: 2px solid transparent;
}

.hub-customhome-page .ch-localnav--underline .ch-localnav__list a:hover {
  border-bottom-color: rgba(36, 25, 16, 0.35);
  color: var(--iezukuri-text);
}

.hub-customhome-page .ch-localnav--underline .ch-localnav__list a.is-active,
.hub-customhome-page .ch-localnav--underline .ch-localnav__list .current-menu-item > a,
.hub-customhome-page .ch-localnav--underline .ch-localnav__list .current_page_item > a {
  background: transparent;
  color: var(--iezukuri-text);
  border-bottom-color: var(--iezukuri-text);
}

.hub-customhome-page .ch-localnav--minimal .ch-localnav__list a {
  min-height: auto;
  padding: 8px 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.hub-customhome-page .ch-localnav--minimal .ch-localnav__list a.is-active {
  background: transparent;
  color: #9b6a31;
}

/* =========================================================
 * 06. Sections
 * ========================================================= */

.hub-customhome-page .ch-section {
  padding: 86px 0;
  background: var(--iezukuri-bg);
}

.hub-customhome-page .ch-section--white {
  background: var(--iezukuri-surface);
}

.hub-customhome-page .ch-head {
  margin-bottom: 34px;
  text-align: center;
}

.hub-customhome-page .ch-head--with-link {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
}

.hub-customhome-page .ch-eyebrow {
  display: inline-block;
  color: #9b6a31;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.18em;
}

.hub-customhome-page .ch-eyebrow--light {
  color: rgba(255, 255, 255, 0.72);
}

.hub-customhome-page .ch-section-title {
  margin: 14px 0 0;
  color: var(--iezukuri-text);
  font-size: 40px;
  line-height: 1.25;
}

.hub-customhome-page .ch-inline-link {
  color: var(--iezukuri-text);
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
}

.hub-customhome-page .ch-inline-link:hover {
  color: #9b6a31;
}

/* =========================================================
 * 07. Feature / Works / Flow
 * ========================================================= */

.hub-customhome-page .ch-feature-grid,
.hub-customhome-page .ch-works-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 22px;
}

.hub-customhome-page .ch-flow-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.hub-customhome-page .ch-feature-card,
.hub-customhome-page .ch-work-card,
.hub-customhome-page .ch-flow-item,
.hub-customhome-page .ch-company-box {
  border: 1px solid rgba(77, 53, 29, 0.1);
  background: var(--iezukuri-surface);
  box-shadow: 0 16px 36px rgba(24, 18, 14, 0.06);
}

.hub-customhome-page .ch-feature-card {
  padding: 30px 24px;
  border-radius: 24px;
  text-align: center;
}

.hub-customhome-page .ch-work-card {
  overflow: hidden;
  border-radius: 24px;
}

.hub-customhome-page .ch-flow-item {
  position: relative;
  padding: 26px 18px 22px;
  border-radius: 22px;
  text-align: center;
}

.hub-customhome-page .ch-feature-card__icon,
.hub-customhome-page .ch-flow-item__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #a27743;
}

.hub-customhome-page .ch-feature-card__icon {
  width: 56px;
  height: 56px;
  margin: 0 auto 18px;
}

.hub-customhome-page .ch-flow-item__icon {
  width: 54px;
  height: 54px;
  margin: 0 auto 16px;
}

.hub-customhome-page .ch-feature-card__icon svg,
.hub-customhome-page .ch-flow-item__icon svg {
  display: block;
  width: 100%;
  height: 100%;
}

.hub-customhome-page .ch-feature-card__title {
  margin: 0 0 12px;
  color: var(--iezukuri-text);
  font-size: 23px;
  line-height: 1.45;
}

.hub-customhome-page .ch-feature-card__text,
.hub-customhome-page .ch-work-card__text,
.hub-customhome-page .ch-flow-item__text {
  margin: 0;
  color: #6a5d4f;
  font-size: 15px;
  line-height: 1.8;
}

.hub-customhome-page .ch-work-card__thumb {
  position: relative;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(183, 130, 66, 0.1), rgba(183, 130, 66, 0.18)), #ede4d7;
}

.hub-customhome-page .ch-work-card__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hub-customhome-page .ch-work-card__body {
  padding: 18px 18px 22px;
}

.hub-customhome-page .ch-work-card__title {
  margin: 0 0 8px;
  color: var(--iezukuri-text);
  font-size: 19px;
  line-height: 1.45;
}

.hub-customhome-page .ch-flow-item__num {
  margin-bottom: 12px;
  color: #9b6a31;
  font-size: 18px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.hub-customhome-page .ch-flow-item__title {
  margin: 0 0 8px;
  color: var(--iezukuri-text);
  font-size: 18px;
  line-height: 1.5;
}

/* more */
.hub-customhome-page .ch-more-toggle {
  display: flex;
  justify-content: center;
  margin-top: 28px;
}

.hub-customhome-page .ch-more-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 48px;
  padding: 0 22px;
  border: 1px solid rgba(77, 53, 29, 0.16);
  border-radius: 999px;
  background: var(--iezukuri-surface);
  color: var(--iezukuri-text);
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
}

.hub-customhome-page .ch-more-btn:hover {
  background: #f5ecdf;
}

.hub-customhome-page .ch-more-btn__loading {
  display: none;
  width: 16px;
  height: 16px;
  border: 2px solid rgba(36, 25, 16, 0.18);
  border-top-color: var(--iezukuri-text);
  border-radius: 999px;
  animation: chSpin 0.8s linear infinite;
}

.hub-customhome-page .ch-more-btn.is-loading .ch-more-btn__loading {
  display: inline-block;
}

.hub-customhome-page .ch-more-panel {
  margin-top: 22px;
  opacity: 0;
  transform: translateY(18px);
  transition: opacity 0.22s ease, transform 0.22s ease;
}

.hub-customhome-page .ch-more-panel.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.hub-customhome-page .ch-works-grid--more {
  margin-top: 0;
}

.hub-customhome-page .ch-work-card.is-more {
  animation: chFadeUp 0.35s ease both;
}

.hub-customhome-page .ch-more-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.hub-customhome-page .ch-more-card {
  display: grid;
  gap: 10px;
  padding: 22px 20px;
  border-radius: 22px;
  background: var(--iezukuri-surface);
  border: 1px solid rgba(77, 53, 29, 0.1);
  box-shadow: 0 16px 36px rgba(24, 18, 14, 0.06);
  color: var(--iezukuri-text);
  text-decoration: none;
}

.hub-customhome-page .ch-more-card__eyebrow {
  color: #9b6a31;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.hub-customhome-page .ch-more-card__title {
  font-size: 20px;
  line-height: 1.45;
}

.hub-customhome-page .ch-more-card__text {
  color: #6a5d4f;
  font-size: 14px;
  line-height: 1.8;
}

/* =========================================================
 * 08. Company
 * ========================================================= */

.hub-customhome-page .ch-company-box {
  padding: 34px 30px;
  border-radius: 24px;
  text-align: center;
}

.hub-customhome-page .ch-company-box__text {
  width: 760px;
  max-width: 100%;
  margin: 0 auto;
  color: #6a5d4f;
  font-size: 16px;
  line-height: 1.9;
}

.hub-customhome-page .ch-company-box__actions {
  display: flex;
  justify-content: center;
  margin-top: 22px;
}

/* =========================================================
 * 09. CTA / split layout
 * ========================================================= */

.hub-customhome-page .ch-cta {
  padding: 0 0 96px;
  background: var(--iezukuri-bg);
}

.hub-customhome-page .ch-cta .ch-shell {
  width: calc(100% - 80px);
  max-width: 1280px;
  margin: 0 auto;
}

.hub-customhome-page .ch-cta__grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  height: 260px;
  overflow: hidden;
  border-radius: 28px;
  background: #2c2119;
  box-shadow: 0 22px 54px rgba(24, 18, 14, 0.14);
}

.hub-customhome-page .ch-cta__media,
.hub-customhome-page .ch-cta__body {
  min-width: 0;
  height: 260px;
}

.hub-customhome-page .ch-cta__media {
  overflow: hidden;
  padding: 0;
  background: #2c2119;
}

.hub-customhome-page .ch-cta-swiper,
.hub-customhome-page .ch-cta-swiper .swiper-wrapper,
.hub-customhome-page .ch-cta-swiper .swiper-slide {
  width: 100%;
  height: 260px;
  min-height: 0;
}

.hub-customhome-page .ch-cta__image,
.hub-customhome-page .ch-cta__media img,
.hub-customhome-page .ch-cta__media video {
  width: 100%;
  height: 260px;
  max-height: none;
  display: block;
  object-fit: cover;
}

.hub-customhome-page .ch-cta__body {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 24px 48px;
  color: var(--iezukuri-surface);
  background: #2c2119;
}

.hub-customhome-page .ch-cta__title {
  margin: 0 0 12px;
  color: var(--iezukuri-surface);
  font-size: 32px;
  line-height: 1.2;
  letter-spacing: 0.04em;
}

.hub-customhome-page .ch-cta__text {
  margin: 0 0 18px;
  color: rgba(255,255,255,0.84);
  line-height: 1.75;
}

.hub-customhome-page .ch-cta__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.hub-customhome-page .ch-cta__media .swiper-button-prev,
.hub-customhome-page .ch-cta__media .swiper-button-next {
  color: var(--iezukuri-surface);
}

@media (max-width: 900px) {
  .hub-customhome-page .ch-cta {
    padding: 0 0 64px;
  }

  .hub-customhome-page .ch-cta .ch-shell {
    width: calc(100% - 28px);
  }

  .hub-customhome-page .ch-cta__grid {
    grid-template-columns: 1fr;
    height: auto;
  }

  .hub-customhome-page .ch-cta__media,
  .hub-customhome-page .ch-cta__body,
  .hub-customhome-page .ch-cta-swiper,
  .hub-customhome-page .ch-cta-swiper .swiper-wrapper,
  .hub-customhome-page .ch-cta-swiper .swiper-slide,
  .hub-customhome-page .ch-cta__image,
  .hub-customhome-page .ch-cta__media img,
  .hub-customhome-page .ch-cta__media video {
    height: 220px;
  }

  .hub-customhome-page .ch-cta__body {
    height: auto;
    padding: 30px 24px;
