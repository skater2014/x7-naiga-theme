/* =========================================================
 * 10. Entrance route cards
 *
 * 対象:
 * - /iezukuri/ トップ
 * - ch-route-grid / ch-route-card
 *
 * 役割:
 * - 家づくりの入口カードだけ
 * - service / subpage のCSSは入れない
 * ========================================================= */

.hub-customhome-page.hub-customhome-top .ch-route-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: clamp(16px, 2.2vw, 28px);
  align-items: stretch;
}

.hub-customhome-page.hub-customhome-top .ch-route-card {
  min-width: 0;
  height: 100%;
  overflow: hidden;
  border: 1px solid var(--iezukuri-border);
  border-radius: 26px;
  background: var(--iezukuri-surface);
  box-shadow: var(--iezukuri-shadow-soft);
}

.hub-customhome-page.hub-customhome-top .ch-route-card a {
  display: grid;
  grid-template-rows: 180px 1fr;
  height: 100%;
  color: inherit;
  text-decoration: none;
}

.hub-customhome-page.hub-customhome-top .ch-route-card__image {
  display: grid;
  place-items: center;
  min-height: 180px;
  overflow: hidden;
  background: var(--iezukuri-bg-warm);
}

.hub-customhome-page.hub-customhome-top .ch-route-card__image img {
  display: block;
  width: 100%;
  height: 180px;
  object-fit: cover;
}

.hub-customhome-page.hub-customhome-top .ch-route-card__image span {
  display: grid;
  place-items: center;
  width: 74px;
  height: 74px;
  border-radius: 999px;
  background: rgba(255,255,255,.82);
  color: var(--iezukuri-accent-strong);
  font-weight: 900;
}

.hub-customhome-page.hub-customhome-top .ch-route-card__body {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 220px;
  padding: clamp(20px, 2.5vw, 28px);
}

.hub-customhome-page.hub-customhome-top .ch-route-card__label {
  margin: 0 0 10px;
  color: var(--iezukuri-accent);
  font-size: 12px;
  font-weight: 900;
  letter-spacing: .14em;
}

.hub-customhome-page.hub-customhome-top .ch-route-card h3 {
  margin: 0;
  color: var(--iezukuri-text-strong);
  font-size: clamp(19px, 2vw, 24px);
  line-height: 1.45;
}

.hub-customhome-page.hub-customhome-top .ch-route-card p {
  margin: 12px 0 0;
  color: var(--iezukuri-muted);
  font-size: 15px;
  line-height: 1.85;
}

.hub-customhome-page.hub-customhome-top .ch-route-card b {
  display: inline-flex;
  width: fit-content;
  margin-top: auto;
  padding-top: 20px;
  color: var(--iezukuri-accent-strong);
  font-size: 14px;
  font-weight: 900;
}

.hub-customhome-page.hub-customhome-top .ch-route-card b::after {
  content: "→";
  margin-left: .6em;
}

@media (max-width: 1180px) {
  .hub-customhome-page.hub-customhome-top .ch-route-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 680px) {
  .hub-customhome-page.hub-customhome-top .ch-route-grid {
    grid-template-columns: 1fr;
  }

  .hub-customhome-page.hub-customhome-top .ch-route-card a {
