/* =========================================================
 * 11. Animation
 * ========================================================= */

@keyframes chSpin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes chFadeUp {
  from {
    opacity: 0;
    transform: translateY(14px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

