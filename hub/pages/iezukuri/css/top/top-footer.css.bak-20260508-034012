/* =========================================================
 * hub/pages/iezukuri/css/top/top-footer.css
 *
 * /iezukuri トップ Footer 専用
 *
 * 役割:
 * - Footerの会社情報
 * - Footerメニュー
 * - Footer下部コピーライト
 *
 * CTAは section-cta.php の .ch-cta で管理する。
 * ========================================================= */

.hub-customhome-page.hub-customhome-top {
  padding-bottom: 104px;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer {
  width: 100vw;
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
  padding: clamp(56px, 7vw, 88px) 0 124px;
  background:
    linear-gradient(180deg, color-mix(in srgb, var(--iezukuri-bg) 92%, #fff), var(--iezukuri-bg));
  color: var(--iezukuri-text);
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer .ch-shell {
  width: calc(100% - 80px);
  max-width: 1280px;
  margin: 0 auto;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__grid {
  display: grid;
  grid-template-columns: minmax(300px, 1.25fr) minmax(180px, .8fr) minmax(180px, .8fr);
  gap: clamp(28px, 5vw, 72px);
  align-items: start;
  padding: clamp(30px, 4vw, 48px);
  border-radius: 30px;
  background: var(--iezukuri-surface);
  border: 1px solid var(--iezukuri-border);
  box-shadow: var(--iezukuri-shadow-soft);
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__company,
.hub-customhome-page.hub-customhome-top .ch-lp-footer__nav {
  min-width: 0;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__label {
  margin: 0 0 8px;
  color: var(--iezukuri-accent-strong);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer h3,
.hub-customhome-page.hub-customhome-top .ch-lp-footer h4 {
  margin: 0 0 14px;
  color: var(--iezukuri-text-strong);
  font-size: 18px;
  line-height: 1.45;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer p {
  margin: 0 0 10px;
  color: var(--iezukuri-muted);
  font-size: 14px;
  line-height: 1.85;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer a {
  color: var(--iezukuri-accent-strong);
  text-decoration: underline;
  text-underline-offset: 4px;
  font-weight: 800;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer ul {
  display: grid;
  gap: 10px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer li {
  margin: 0;
  padding: 0;
  list-style: none;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__bottom {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 28px;
  margin-top: 30px;
  color: var(--iezukuri-muted);
  font-size: 13px;
  text-align: center;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__bottom p {
  margin: 0;
}

@media (max-width: 900px) {
  .hub-customhome-page.hub-customhome-top {
    padding-bottom: 122px;
  }

  .hub-customhome-page.hub-customhome-top .ch-lp-footer .ch-shell {
    width: calc(100% - 28px);
  }

  .hub-customhome-page.hub-customhome-top .ch-lp-footer__grid {
    grid-template-columns: 1fr;
    gap: 24px;
    padding: 24px 18px;
  }

  .hub-customhome-page.hub-customhome-top .ch-lp-footer__bottom {
    flex-direction: column;
    gap: 10px;
  }
}
