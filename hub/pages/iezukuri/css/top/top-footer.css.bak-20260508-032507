/* =========================================================
 * hub/pages/iezukuri/css/top/top-footer.css
 *
 * /iezukuri トップ Footer 専用
 *
 * 役割:
 * - Footerの会社情報
 * - Footerメニュー
 * - Footer下部コピーライト
 *
 * 方針:
 * - ch-cta は既存の相談CTAとして使う
 * - ch-lp-footer__cta は使わない
 * - 固定フッターCTAに本文が隠れないよう余白を確保
 * ========================================================= */

.hub-customhome-page.hub-customhome-top {
  padding-bottom: 96px;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer {
  width: 100%;
  padding: clamp(48px, 6vw, 76px) 0 110px;
  background: var(--iezukuri-bg);
  color: var(--iezukuri-text);
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer .ch-shell {
  width: calc(100% - 80px);
  max-width: 1280px;
  margin: 0 auto;
}

/* 既存CTAがあるのでFooter内CTAは不要 */
.hub-customhome-page.hub-customhome-top .ch-lp-footer__cta {
  display: none !important;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__grid {
  display: grid;
  grid-template-columns: minmax(280px, 1.25fr) minmax(180px, .8fr) minmax(180px, .8fr);
  gap: clamp(28px, 5vw, 72px);
  align-items: start;
  padding: clamp(28px, 4vw, 44px);
  border-radius: 28px;
  background: color-mix(in srgb, var(--iezukuri-text) 4%, var(--iezukuri-surface));
  border: 1px solid var(--iezukuri-border);
  box-shadow: var(--iezukuri-shadow-soft);
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__grid h3,
.hub-customhome-page.hub-customhome-top .ch-lp-footer__grid h4 {
  margin: 0 0 14px;
  color: var(--iezukuri-text-strong);
  font-size: 17px;
  line-height: 1.5;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__grid p {
  margin: 0;
  color: var(--iezukuri-muted);
  font-size: 14px;
  line-height: 1.85;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__grid a {
  color: var(--iezukuri-accent-strong);
  text-decoration: underline;
  text-underline-offset: 4px;
  font-weight: 700;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__grid ul {
  display: grid;
  gap: 10px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__grid li {
  margin: 0;
  padding: 0;
  list-style: none;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__bottom {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 28px;
  margin-top: 30px;
  color: var(--iezukuri-muted);
  font-size: 13px;
  text-align: center;
}

/* 見出し：ユーザーに「何を選べばいいか」を伝える */
.hub-customhome-page.hub-customhome-top .ch-site-reading {
  position: relative;
  overflow: hidden;
}

.hub-customhome-page.hub-customhome-top .ch-site-reading::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 12% 20%, color-mix(in srgb, var(--iezukuri-accent) 12%, transparent), transparent 34%),
    radial-gradient(circle at 90% 0%, color-mix(in srgb, var(--iezukuri-accent) 8%, transparent), transparent 30%);
  pointer-events: none;
}

.hub-customhome-page.hub-customhome-top .ch-site-reading .ch-shell {
  position: relative;
  z-index: 1;
}

.hub-customhome-page.hub-customhome-top .ch-route-card {
  transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
}

.hub-customhome-page.hub-customhome-top .ch-route-card:hover {
  transform: translateY(-4px);
  border-color: color-mix(in srgb, var(--iezukuri-accent) 45%, var(--iezukuri-border));
  box-shadow: 0 24px 54px rgba(24, 18, 14, .12);
}

.hub-customhome-page.hub-customhome-top .ch-route-card b {
  transition: transform .22s ease;
}

.hub-customhome-page.hub-customhome-top .ch-route-card:hover b {
  transform: translateX(4px);
}

@media (max-width: 900px) {
  .hub-customhome-page.hub-customhome-top {
    padding-bottom: 118px;
  }

  .hub-customhome-page.hub-customhome-top .ch-lp-footer .ch-shell {
    width: calc(100% - 28px);
  }

  .hub-customhome-page.hub-customhome-top .ch-lp-footer__grid {
    grid-template-columns: 1fr;
    padding: 24px 18px;
  }

  .hub-customhome-page.hub-customhome-top .ch-lp-footer__bottom {
    flex-direction: column;
    gap: 10px;
  }
}
