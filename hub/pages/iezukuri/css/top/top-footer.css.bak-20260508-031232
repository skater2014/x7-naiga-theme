/* =========================================================
 * hub/pages/iezukuri/css/top/top-footer.css
 *
 * 対象:
 * - /iezukuri/ トップ LP下部フッター
 * ========================================================= */

.hub-customhome-page.hub-customhome-top .ch-lp-footer {
  padding: 0 0 42px;
  background: var(--iezukuri-bg);
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__cta {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 24px;
  align-items: center;
  padding: clamp(22px, 3vw, 36px);
  border-radius: 28px;
  background: var(--iezukuri-surface);
  border: 1px solid var(--iezukuri-border);
  box-shadow: var(--iezukuri-shadow, 0 16px 36px rgba(24, 18, 14, .06));
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__cta h2 {
  margin: 8px 0 0;
  color: var(--iezukuri-text);
  font-size: clamp(24px, 3vw, 36px);
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__cta p {
  margin: 10px 0 0;
  color: var(--iezukuri-muted);
  line-height: 1.75;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__cta-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  justify-content: flex-end;
}

.hub-customhome-page.hub-customhome-top .ch-btn--ghost-dark {
  background: transparent;
  border: 1px solid var(--iezukuri-border);
  color: var(--iezukuri-text);
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr;
  gap: clamp(20px, 3vw, 42px);
  margin-top: 22px;
  padding: clamp(22px, 3vw, 34px);
  border-radius: 28px;
  background: #2b2118;
  color: rgba(255,255,255,.82);
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__grid h3 {
  margin: 0 0 12px;
  color: #fff;
  font-size: 17px;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__grid p {
  margin: 0 0 8px;
  line-height: 1.7;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__grid a {
  display: block;
  width: fit-content;
  margin: 0 0 8px;
  color: rgba(255,255,255,.88);
  text-decoration: none;
  font-weight: 700;
}

.hub-customhome-page.hub-customhome-top .ch-lp-footer__grid a:hover {
  color: #d9b36c;
}

@media (max-width: 820px) {
  .hub-customhome-page.hub-customhome-top .ch-lp-footer__cta,
  .hub-customhome-page.hub-customhome-top .ch-lp-footer__grid {
    grid-template-columns: 1fr;
  }

  .hub-customhome-page.hub-customhome-top .ch-lp-footer__cta-actions {
    justify-content: flex-start;
  }
}
