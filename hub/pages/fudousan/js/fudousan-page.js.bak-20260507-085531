/*
 * =========================================================
 * /fudousan 専用JS
 * =========================================================
 *
 * ファイル:
 * hub/pages/fudousan/js/fudousan-page.js
 *
 * 読み込み管理:
 * hub/pages/fudousan/inc/assets.php
 *
 * 役割:
 * - /fudousan のカテゴリータブ切り替え
 * - /fudousan の Isotope 初期化
 * - 初期タブを「すべて」ではなく、HTML側の active / data-fudo-default-tab / お勧め土地から決める
 * - /fudousan の予約モーダル表示データ補助
 * - /fudousan の hero swiper 初期化
 *
 * scripts.js との関係:
 * - js/scripts.js にも .home-posts / .home-cats-selection 用の共通 Isotope がある。
 * - ただし /fudousan/ では scripts.js 側が return して止まる設計。
 * - /fudousan/ の Isotope / タブ制御は、このファイルに一本化する。
 *
 * 重要:
 * - scripts.js は共通処理として残す。
 * - /fudousan/ の Isotope を scripts.js に戻さない。
 * - 地図モーダル本体は js/front-map-modal.js が担当。
 * - 予約モーダル本体は共通 scripts.js が担当。
 * =========================================================
 */

/* =========================================================
 * FUDOUSAN_ISOTOPE_OWNER
 * ---------------------------------------------------------
 * /fudousan/ のカテゴリータブ・Isotope 管理
 *
 * 対象:
 * - .fudousan-page
 * - .home-posts
 * - .archive-post-box
 * - .home-cats-selection a
 *
 * 役割:
 * - 物件カード一覧を Isotope で初期化する。
 * - タブクリック時に href="*" / href=".term-10" を filter として使う。
 * - 初期表示でもタブ切替でも、カードを移動アニメーションさせない。
 * - 画像が上から落ちる・斜めから来るような見え方を止める。
 *
 * Isotope公式に合わせる考え方:
 * - itemSelector でカードを指定する。
 * - itemの幅はCSSで管理する。
 * - transitionDuration: 0 で位置移動アニメーションを止める。
 * - hiddenStyle / visibleStyle の transform: scale を使わず、opacityだけにする。
 *
 * なぜこの修正が必要か:
 * - Isotope標準の hiddenStyle / visibleStyle は scale() を使う。
 * - カード本体CSSにも transform hover があると、
 *   画像が上から振り下ろされる・斜め上から来るように見える。
 * - ここでは Isotope 側の transform演出を切る。
 *
 * scripts.js との関係:
 * - scripts.js は共通一覧用。
 * - /fudousan/ では scripts.js 側が return して止まる設計。
 * - /fudousan/ の Isotope はこの fudousan-page.js に一本化する。
 * ========================================================= */
(function ($) {
  'use strict';

  $(function () {
    var $page = $('.fudousan-page');

    if (!$page.length) {
      return;
    }

    var $grid = $page.find('.home-posts').first();
    var $tabs = $page.find('.home-cats-selection a');

    if (!$grid.length || !$tabs.length || typeof $.fn.isotope === 'undefined') {
      return;
    }

    /*
     * 二重初期化防止。
     *
     * 役割:
     * - このファイルが複数回読まれても、同じ .home-posts に
     *   Isotope を二重に初期化しない。
     */
    if ($grid.data('fudousanIsotopeOwner') === '1') {
      return;
    }

    $grid.data('fudousanIsotopeOwner', '1');

    function getInitialFudoTab() {
      var $target = $tabs.filter('.active').first();

      if ($target.length) {
        return $target;
      }

      $target = $tabs.filter('[data-fudo-default-tab="1"]').first();

      if ($target.length) {
        return $target;
      }

      $tabs.each(function () {
        var $tab = $(this);
        var label = $.trim($tab.text());

        if (
          (label.indexOf('お勧めの土地') !== -1 || label.indexOf('おすすめの土地') !== -1) &&
          label.indexOf('土地付き建物') === -1 &&
          label.indexOf('建物') === -1
        ) {
          $target = $tab;
          return false;
        }
      });

      if ($target.length) {
        return $target;
      }

      return $tabs.first();
    }

    function setActiveTab($tab) {
      $tabs.removeClass('active').attr('aria-current', 'false');
      $tab.addClass('active').attr('aria-current', 'true');
    }

    function getFilterFromTab($tab) {
      var filter = $tab.attr('data-fudo-filter') || $tab.attr('href') || '*';

      if (!filter || filter === '#') {
        return '*';
      }

      return filter;
    }

    function isotopeOptions(filter) {
      return {
        itemSelector: '.archive-post-box',
        layoutMode: 'fitRows',
        percentPosition: true,
        filter: filter,

        /*
         * 重要:
         * - Isotope の位置移動アニメーションを完全に止める。
         * - 上から落ちる・斜めから来る見え方をなくす。
         */
        transitionDuration: 0,
        stagger: 0,

        /*
         * 重要:
         * - Isotope標準の hiddenStyle / visibleStyle は scale() を使う。
         * - scale が画像の出入りを「斜め・拡大縮小」のように見せる。
         * - opacity だけにして、transform演出を使わない。
         */
        hiddenStyle: {
          opacity: 0
        },
        visibleStyle: {
          opacity: 1
        }
      };
    }

    function applyFilter(filter) {
      $grid.isotope(isotopeOptions(filter));
    }

    var $initialTab = getInitialFudoTab();
    var initialFilter = getFilterFromTab($initialTab);

    setActiveTab($initialTab);

    function initIsotope() {
      /*
       * fudo-isotope-ready:
       * - 初期化済みの目印。
       * - CSS側ではカード幅の切り替えに使わない。
       * - デバッグ・状態確認用のclassとして扱う。
       */
      $grid.addClass('fudo-isotope-ready');

      if (!$grid.data('isotope')) {
        $grid.isotope(isotopeOptions(initialFilter));
        return;
      }

      applyFilter(initialFilter);
    }

    if (typeof $grid.imagesLoaded === 'function') {
      $grid.imagesLoaded(initIsotope);
    } else {
      initIsotope();
    }

    /*
     * 画像・iframe・lite-youtube などで高さが後から変わる場合の補正。
     * アニメーションは付けず、位置だけ再計算する。
     */
    $(window).one('load.fudousanIsotope', function () {
      if ($grid.data('isotope')) {
        $grid.isotope('layout');
      }
    });

    $tabs
      .off('click.fudousanIsotope')
      .on('click.fudousanIsotope', function (e) {
        e.preventDefault();

        var $tab = $(this);
        var filter = getFilterFromTab($tab);

        setActiveTab($tab);
        applyFilter(filter);
      });
  });
})(jQuery);

/* =========================================================
 * /fudousan reservation data sync only
 * ---------------------------------------------------------
 * 目的:
 * - 予約モーダル本体の開閉処理は共通 scripts.js に任せる。
 * - このファイルでは /fudousan のカードボタンにある data-reservation-* を
 *   モーダル内の表示へ反映するだけ。
 *
 * 注意:
 * - モーダルのレイアウトは触らない。
 * - モーダルを開く処理もここでは書かない。
 * ========================================================= */
(function ($) {
  'use strict';

  function syncFudousanReservationData($btn) {
    var $modal = $('#store-reservation-modal');

    if (!$modal.length || !$btn.length) {
      return;
    }

    var postId = $btn.attr('data-reservation-post-id') || $btn.attr('data-post-id') || '';

    var title = $btn.attr('data-reservation-title') || $btn.attr('data-title') || '';

    var price = $btn.attr('data-reservation-price') || $btn.attr('data-price') || '';

    var address = $btn.attr('data-reservation-address') || $btn.attr('data-address') || '';

    var image =
      $btn.attr('data-reservation-thumbnail') ||
      $btn.attr('data-reservation-thumb') ||
      $btn.attr('data-reservation-image') ||
      $btn.attr('data-thumbnail') ||
      $btn.attr('data-image') ||
      '';

    if (title) {
      $modal.find('#reservation-property-title').text(title);
    }

    if (postId) {
      $modal.find('#reservation-property-label').text('物件ID: ');
      $modal.find('#reservation-property-id').text(postId);
    }

    if (address) {
      $modal.find('#reservation-property-address').text(address);
      $modal
        .find(
          'input[name="property_address"], input[name="reservation_property_address"], input[name="address"]',
        )
        .val(address);
    }

    var $price = $modal.find('#reservation-property-price');

    if ($price.length) {
      $price.text(price || '');
      $price.attr('data-price', price || '');
      $price.attr('data-sold-out', '');
      $price.toggle(!!price);
    }

    var $thumb = $modal.find('#reservation-property-thumbnail');

    if ($thumb.length) {
      if (image) {
        $thumb.css({
          backgroundImage: 'url("' + image + '")',
          backgroundSize: 'cover',
          backgroundPosition: 'center center',
          backgroundRepeat: 'no-repeat',
        });
      } else {
        $thumb.css('backgroundImage', '');
      }
    }
  }

  $(document)
    .off('click.fudousanReservationDataOnly', '.fudousan-page .store-reserve-link')
    .on('click.fudousanReservationDataOnly', '.fudousan-page .store-reserve-link', function () {
      var $btn = $(this);

      /*
       * 共通 scripts.js がモーダルを開いた直後に、
       * /fudousan 側の data-reservation-* で表示内容だけ同期する。
       */
      window.setTimeout(function () {
        syncFudousanReservationData($btn);
      }, 0);

      window.setTimeout(function () {
        syncFudousanReservationData($btn);
      }, 120);
    });
})(jQuery);

/* =========================================================
 * FUDOUSAN HERO SWIPER FINAL
 * ---------------------------------------------------------
 * /fudousan hero Swiper 初期化
 *
 * 役割:
 * - hero の画像・動画スライダーだけを初期化する。
 * - Isotope / 一覧カード / タブ切り替えには触らない。
 *
 * 対象:
 * - .js-fudo-hero-swiper
 * - 旧HTML互換: .fudo-hero-swiper[data-fudo-hero-swiper="1"]
 *
 * 注意:
 * - このブロック1つだけで hero swiper を管理する。
 * - 旧 hero media swiper ブロックは不要。
 * ========================================================= */
(function () {
  'use strict';

  function fudoPlayActiveVideo(swiper) {
    if (!swiper || !swiper.el) {
      return;
    }

    swiper.el.querySelectorAll('video').forEach(function (video) {
      try {
        video.pause();
      } catch (e) {}
    });

    var activeSlide = swiper.slides && swiper.slides[swiper.activeIndex];

    if (!activeSlide) {
      return;
    }

    var activeVideo = activeSlide.querySelector('video');

    if (!activeVideo) {
      return;
    }

    activeVideo.muted = true;
    activeVideo.playsInline = true;

    var promise = activeVideo.play();

    if (promise && typeof promise.catch === 'function') {
      promise.catch(function () {});
    }
  }

  function initFudoHeroSwiper() {
    if (typeof Swiper === 'undefined') {
      return;
    }

    document
      .querySelectorAll(
        '.fudousan-page .js-fudo-hero-swiper:not(.is-fudo-hero-ready), ' +
          '.fudousan-page .fudo-hero-swiper[data-fudo-hero-swiper="1"]:not(.is-fudo-hero-ready)',
      )
      .forEach(function (el) {
        if (el.dataset.fudoHeroSwiperInitialized === '1') {
          return;
        }

        var slideCount = el.querySelectorAll('.swiper-slide').length;

        el.dataset.fudoHeroSwiperInitialized = '1';
        el.classList.add('is-fudo-hero-ready');

        var swiper = new Swiper(el, {
          loop: slideCount > 1,
          speed: 650,
          watchOverflow: true,
          autoplay:
            slideCount > 1
              ? {
                  delay: 5200,
                  disableOnInteraction: false,
                }
              : false,
          pagination: {
            el: el.querySelector('.swiper-pagination'),
            clickable: true,
          },
          navigation: {
            nextEl: el.querySelector('.swiper-button-next'),
            prevEl: el.querySelector('.swiper-button-prev'),
          },
          on: {
            init: function () {
              fudoPlayActiveVideo(this);
            },
            slideChangeTransitionStart: function () {
              fudoPlayActiveVideo(this);
            },
          },
        });

        fudoPlayActiveVideo(swiper);
      });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFudoHeroSwiper);
  } else {
    initFudoHeroSwiper();
  }

  window.addEventListener('load', initFudoHeroSwiper);
})();
